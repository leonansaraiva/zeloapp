<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ZeloApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#0d6efd" />
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/2913/2913133.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <HeadOutlet />
</head>

<body>
    <Routes />

    <!-- MODAL DE RECONEXÃO CUSTOMIZADO EM PORTUGUÊS -->
<div id="components-reconnect-modal" class="components-reconnect-hide">
    <div class="show">
        <p>Tentando reconectar ao servidor...</p>
    </div>
    <div class="failed">
        <p>Falha na conexão. <button class="btn btn-link p-0 text-decoration-underline" onclick="window.location.reload()">Recarregar página</button></p>
    </div>
    <div class="rejected">
        <p>Conexão rejeitada. <button class="btn btn-link p-0 text-decoration-underline" onclick="window.location.reload()">Recarregar página</button></p>
    </div>
</div>
    <script src="_framework/blazor.web.js"></script>

    <!-- SCRIPT ROBUSTO PARA TRADUZIR AS MENSAGENS DE RECONEXÃO DO BLAZOR -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const observer = new MutationObserver(() => {
                const modal = document.querySelector('#components-reconnect-modal');
                if (modal) {
                    // Varre todos os nós de texto dentro do modal de reconexão para traduzir o inglês do framework
                    const walker = document.createTreeWalker(modal, NodeFilter.SHOW_TEXT, null, false);
                    let node;
                    while (node = walker.nextNode()) {
                        if (node.nodeValue.includes("Attempting to reconnect")) {
                            node.nodeValue = "Tentando reconectar ao servidor...";
                        }
                        if (node.nodeValue.includes("Rejoin failed")) {
                            node.nodeValue = "Falha na reconexão... tentando novamente.";
                        }
                        if (node.nodeValue.includes("An unhandled exception has occurred")) {
                            node.nodeValue = "Ocorreu um erro inesperado.";
                        }
                    }
                }
            });

            observer.observe(document.body, { childList: true, subtree: true });
        });
    </script>

    <script src="app.js"></script>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(reg => console.log('PWA ZeloApp registrado!'))
                .catch(err => console.error('Erro PWA:', err));
        }
    </script>
</body>

</html>