@page "/escola/alunos"
@rendermode InteractiveServer
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject AuthStateService Auth

<PageTitle>Todos os Alunos</PageTitle>

<div class="container-fluid py-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0">👶 Visão Geral de Alunos</h3>
            <p class="text-muted small m-0">Lista unificada de todos os alunos matriculados nas turmas da unidade.</p>
        </div>
        <div>
            <input type="text" class="form-control rounded-pill px-4 shadow-sm" placeholder="🔍 Buscar aluno por nome..." @bind="termoBusca" @bind:event="oninput" style="width: 280px;" />
        </div>
    </div>

    <!-- Tabela para Desktop -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden d-none d-md-block">
        <div class="table-responsive">
            <table class="table align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Aluno</th>
                        <th>Turma</th>
                        <th>Vínculo</th>
                        <th>Turno</th>
                        <th>Responsáveis</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in AlunosFiltrados)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(aluno.FotoUrl))
                                    {
                                        <img src="@aluno.FotoUrl" class="rounded-circle object-fit-cover" style="width: 35px; height: 35px;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 35px; height: 35px; font-size: 0.75rem;">
                                            @aluno.NomeCompleto.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@aluno.NomeCompleto</div>
                                        <small class="text-muted">Matrícula: @aluno.DataMatricula.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">@(aluno.Turma?.Nome ?? "Sem Turma")</span></td>
                            <td>@aluno.Vinculo</td>
                            <td>@aluno.Turno</td>
                            <td>
                                <a href="/escola/aluno/@aluno.Id/responsaveis" class="text-decoration-none fw-semibold text-primary">
                                    👥 Gerenciar Responsáveis
                                </a>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/escola/turma/@aluno.TurmaId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                    Ver Turma →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Cards para Mobile (Zero Scroll Horizontal) -->
    <div class="d-block d-md-none">
        <div class="d-flex flex-column gap-3">
            @foreach (var aluno in AlunosFiltrados)
            {
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(aluno.FotoUrl))
                        {
                            <img src="@aluno.FotoUrl" class="rounded-circle object-fit-cover" style="width: 45px; height: 45px;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px; font-size: 0.9rem;">
                                @aluno.NomeCompleto.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <div>
                            <div class="fw-bold text-dark fs-6">@aluno.NomeCompleto</div>
                            <small class="text-muted">Matrícula: @aluno.DataMatricula.ToString("dd/MM/yyyy")</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center small mb-2 pb-2 border-bottom">
                        <span class="text-muted">Turma / Turno:</span>
                        <span class="fw-semibold text-dark">@(aluno.Turma?.Nome ?? "Sem Turma") (@aluno.Turno)</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center small mb-3">
                        <span class="text-muted">Vínculo:</span>
                        <span class="badge bg-light text-dark border px-2 py-1">@aluno.Vinculo</span>
                    </div>

                    <div class="d-flex gap-2 pt-1">
                        <a href="/escola/aluno/@aluno.Id/responsaveis" class="btn btn-sm btn-outline-primary rounded-pill w-50 py-1.5" style="font-size: 0.75rem;">
                            👥 Responsáveis
                        </a>
                        <a href="/escola/turma/@aluno.TurmaId" class="btn btn-sm btn-outline-secondary rounded-pill w-50 py-1.5" style="font-size: 0.75rem;">
                            Ver Turma →
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Aluno> listaAlunos = new();
    private string termoBusca = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        listaAlunos = await Db.Alunos
            .Include(a => a.Turma)
            .OrderBy(a => a.NomeCompleto)
            .ToListAsync();
    }

    private IEnumerable<Aluno> AlunosFiltrados => 
        string.IsNullOrWhiteSpace(termoBusca) 
            ? listaAlunos 
            : listaAlunos.Where(a => a.NomeCompleto.Contains(termoBusca, StringComparison.OrdinalIgnoreCase));
}