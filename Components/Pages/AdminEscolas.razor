@page "/superadmin/escolas"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Gestão de Escolas</PageTitle>

<div class="container py-2 px-3">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold m-0 text-dark">🏫 Gestão de Escolas</h4>
            <small class="text-muted">Cadastre e gerencie as instituições</small>
        </div>
        <button class="btn btn-primary btn-sm fw-semibold" @onclick="() => exibirModalEscola = true">+ Nova Escola</button>
    </div>

    <!-- Lista de Escolas em Cards Mobile (Sem tabelas) -->
    @if (escolas == null || !escolas.Any())
    {
        <div class="card border-0 shadow-sm p-4 text-center text-muted">
            Nenhuma escola cadastrada até o momento.
        </div>
    }
    else
    {
        @foreach (var item in escolas)
        {
            <div class="mobile-card mb-3 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h6 class="fw-bold text-primary m-0">@item.Nome</h6>
                        <small class="text-muted">CNPJ: @item.Cnpj</small>
                    </div>
                    <span class="badge bg-success">Ativa</span>
                </div>

                <div class="bg-light p-2 rounded mb-2 small text-muted">
                    <div><strong>Diretor(a):</strong> @item.NomeGestor</div>
                    <div><strong>E-mail:</strong> @item.EmailGestor</div>
                    <div><strong>Contato:</strong> @item.Telefone</div>
                </div>

                <div class="d-flex justify-content-end">
                    <a href="/superadmin/escolas/@item.Id" class="btn btn-sm btn-primary w-100 fw-semibold text-center">
                        Gerenciar Turmas e Alunos →
                    </a>
                </div>
            </div>
        }
    }
</div>

<!-- MODAL CADASTRAR ESCOLA -->
@if (exibirModalEscola)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold">➕ Cadastrar Nova Escola</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalEscola = false"></button>
                </div>
                <EditForm Model="novaEscola" OnValidSubmit="SalvarEscola">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-3">
                        <div class="mb-2">
                            <label class="form-label small font-semibold">Nome da Escola</label>
                            <InputText class="form-control form-control-sm" @bind-Value="novaEscola.Nome" placeholder="Ex: Escola Saber Mais" />
                            <ValidationMessage For="@(() => novaEscola.Nome)" class="text-danger small" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small font-semibold">CNPJ</label>
                            <InputText class="form-control form-control-sm" @bind-Value="novaEscola.Cnpj" placeholder="12.345.678/0001-95" />
                            <ValidationMessage For="@(() => novaEscola.Cnpj)" class="text-danger small" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small font-semibold">Nome do Gestor/Diretor</label>
                            <InputText class="form-control form-control-sm" @bind-Value="novaEscola.NomeGestor" placeholder="Ex: Ana Maria" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small font-semibold">E-mail do Gestor</label>
                            <InputText class="form-control form-control-sm" @bind-Value="novaEscola.EmailGestor" placeholder="gestor@escola.com" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small font-semibold">Telefone</label>
                            <InputText class="form-control form-control-sm" @bind-Value="novaEscola.Telefone" placeholder="(41) 99999-8888" />
                        </div>
                    </div>
                    <div class="modal-footer p-2">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => exibirModalEscola = false">Cancelar</button>
                        <button type="submit" class="btn btn-primary btn-sm">Salvar Escola</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Escola> escolas = new();
    private Escola novaEscola = new();
    private bool exibirModalEscola = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEscolas();
    }

    private async Task CarregarEscolas()
    {
        escolas = await Db.Escolas.ToListAsync();
    }

    private async Task SalvarEscola()
    {
        Db.Escolas.Add(novaEscola);
        await Db.SaveChangesAsync();
        exibirModalEscola = false;
        novaEscola = new Escola();
        await CarregarEscolas();
    }
}