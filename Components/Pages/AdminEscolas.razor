@page "/superadmin/escolas"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Super Admin</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛡️ Zelo - Gestão de Escolas</h2>
        <button class="btn btn-primary" @onclick="AbrirModal">+ Nova Escola</button>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Escola</th>
                <th>CNPJ</th>
                <th>Gestor</th>
                <th>E-mail</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (escolas == null || !escolas.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Nenhuma escola cadastrada ainda.</td>
                </tr>
            }
            else
            {
                @foreach (var item in escolas)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Nome</strong></td>
                        <td>@item.Cnpj</td>
                        <td>@item.NomeGestor</td>
                        <td>@item.EmailGestor</td>
                        <td>
                            <span class="badge @(item.Ativo ? "bg-success" : "bg-danger")">
                                @(item.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (exibirModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cadastrar Nova Escola</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <EditForm Model="novaEscola" OnValidSubmit="SalvarEscola">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nome da Escola / Creche</label>
                            <InputText class="form-control" @bind-Value="novaEscola.Nome" placeholder="Ex: Creche Anjo Gabriel" />
                            <ValidationMessage For="@(() => novaEscola.Nome)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">CNPJ</label>
                            <InputText class="form-control" @bind-Value="novaEscola.Cnpj" placeholder="00.000.000/0001-00" />
                            <ValidationMessage For="@(() => novaEscola.Cnpj)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nome do Gestor/Diretora</label>
                            <InputText class="form-control" @bind-Value="novaEscola.NomeGestor" placeholder="Nome Completo" />
                            <ValidationMessage For="@(() => novaEscola.NomeGestor)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">E-mail do Gestor</label>
                            <InputText class="form-control" @bind-Value="novaEscola.EmailGestor" placeholder="diretoria@escola.com" />
                            <ValidationMessage For="@(() => novaEscola.EmailGestor)" class="text-danger" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Salvar e Liberar Acesso</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Escola> escolas = new();
    private Escola novaEscola = new();
    private bool exibirModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEscolas();
    }

    private async Task CarregarEscolas()
    {
        escolas = await Db.Escolas.ToListAsync();
    }

    private void AbrirModal()
    {
        novaEscola = new Escola();
        exibirModal = true;
    }

    private void FecharModal() => exibirModal = false;

    private async Task SalvarEscola()
    {
        Db.Escolas.Add(novaEscola);
        await Db.SaveChangesAsync();
        exibirModal = false;
        await CarregarEscolas();
    }
}