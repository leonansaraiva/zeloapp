@page "/escola/turma/{TurmaId:int}"
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject AuthStateService Auth
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- CABEÇALHO DA TURMA -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2" @onclick="VoltarPainelEscola">← Voltar para a Unidade</button>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold text-dark m-0 fs-3">📁 Turma: @turma.Nome</h2>
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2.5 py-1 rounded-pill">Turno: @turma.Turno</span>
            </div>
            <p class="text-muted small m-0 mt-1">👩‍🏫 Professora Responsável: <strong class="text-dark">@(string.IsNullOrEmpty(turma.ProfessorResponsavel) ? "Não definida" : turma.ProfessorResponsavel)</strong></p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm btn-sm" @onclick="AbrirModalNovoAluno">
                + Matricular Aluno na Turma
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-4 p-3 shadow-sm mb-4">✅ @mensagemSucesso</div>
    }

    <!-- MÉTRICAS DA TURMA -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4 h-100">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Receita Efetiva da Turma</small>
                <span class="fs-5 fs-md-4 fw-bold text-success">R$ @receitaEfetivaTurma.ToString("N2")</span>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4 h-100">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Previsão Total da Turma</small>
                <span class="fs-5 fs-md-4 fw-bold text-primary">R$ @receitaPrevisaoTurma.ToString("N2")</span>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-danger border-4 h-100">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Inadimplentes na Turma</small>
                <span class="fs-5 fs-md-4 fw-bold text-danger">@inadimplentesTurma alunos</span>
            </div>
        </div>
    </div>

    <!-- LISTA DE ALUNOS -->
<!-- LISTA DE ALUNOS -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white p-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark m-0 fs-6">👶 Alunos Matriculados</h5>
            <span class="badge bg-secondary rounded-pill px-3 py-1">@(turma.Alunos?.Count ?? 0) alunos</span>
        </div>
        
        @if (turma.Alunos == null || turma.Alunos.Count == 0)
        {
            <div class="text-center p-5">
                <p class="text-muted small">Nenhum aluno matriculado nesta turma ainda.</p>
                <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="AbrirModalNovoAluno">+ Adicionar Primeiro Aluno</button>
            </div>
        }
        else
        {
            <!-- VISÃO DE TABELA PARA DESKTOP -->
            <div class="table-responsive d-none d-md-block">
                <table class="table align-middle mb-0 small">
                    <thead class="table-light text-secondary uppercase">
                        <tr>
                            <th class="ps-3">Aluno(a)</th>
                            <th>Vínculo</th>
                            <th>Turno</th>
                            <th>Responsável</th>
                            <th>Mensalidade</th>
                            <th class="text-end pe-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var aluno in turma.Alunos)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(aluno.FotoUrl) ? "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=150&auto=format&fit=crop&q=80" : aluno.FotoUrl)" class="rounded-circle border shadow-sm" style="width: 32px; height: 32px; object-fit: cover;" />
                                        <span class="fw-bold text-dark">@aluno.Nome</span>
                                    </div>
                                </td>
                                <td>
                                    @if (aluno.ConvenioPrefeitura)
                                    {
                                        <span class="badge bg-info-subtle text-info px-2 py-0.5 rounded-pill fw-semibold">Prefeitura</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-dark px-2 py-0.5 rounded-pill fw-semibold">Particular</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border px-2 py-0.5 fw-semibold">@aluno.TurnoAluno</span></td>
                                <td>
                                    <div class="text-dark">@aluno.NomeResponsavel</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">@aluno.TelefoneResponsavel</small>
                                </td>
                                <td><span class="fw-bold text-success">R$ @aluno.ValorMensalidade.ToString("N2")</span></td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1" style="font-size: 0.75rem;" @onclick="() => AbrirModalFicha(aluno)">
                                        Gerenciar →
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- VISÃO EM CARDS PARA CELULAR (ZERO SCROLL LATERAL) -->
            <div class="d-block d-md-none p-3">
                <div class="d-flex flex-column gap-3">
                    @foreach (var aluno in turma.Alunos)
                    {
                        <div class="card border shadow-none rounded-4 p-3 bg-light">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img src="@(string.IsNullOrEmpty(aluno.FotoUrl) ? "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=150&auto=format&fit=crop&q=80" : aluno.FotoUrl)" class="rounded-circle border shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                <div>
                                    <h6 class="fw-bold text-dark m-0">@aluno.Nome</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">Resp: @aluno.NomeResponsavel (@aluno.TelefoneResponsavel)</small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small mb-3 text-muted">
                                <div>Turno: <strong class="text-dark">@aluno.TurnoAluno</strong></div>
                                <div>Valor: <strong class="text-success">R$ @aluno.ValorMensalidade.ToString("N2")</strong></div>
                            </div>
                            <button class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm" style="font-size: 0.8rem;" @onclick="() => AbrirModalFicha(aluno)">
                                Gerenciar Ficha & Boletos →
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL FICHA CADASTRAL, BOLETOS E AUTORIZADOS DO ALUNO -->
@if (exibirModalFicha && alunoSelecionado != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg mx-2 mx-md-auto">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <div class="d-flex align-items-center gap-2">
                        <img src="@(string.IsNullOrEmpty(alunoTemp.FotoUrl) ? "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=150&auto=format&fit=crop&q=80" : alunoTemp.FotoUrl)" class="rounded-circle border border-2 border-white shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" />
                        <div>
                            <h5 class="modal-title fw-bold m-0 fs-6">👶 Ficha & Boletos: @alunoSelecionado.Nome</h5>
                            <small class="text-white-50" style="font-size: 0.7rem;">@turma.Nome | Turno: @alunoTemp.TurnoAluno</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalFicha = false"></button>
                </div>
                <div class="modal-body p-3 p-md-4" style="max-height: 75vh; overflow-y: auto;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark m-0 fs-6">📋 Informações Cadastrais</h6>
                        @if (!editandoAluno)
                        {
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1" style="font-size: 0.75rem;" @onclick="() => editandoAluno = true">✏️ Editar Ficha</button>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" style="font-size: 0.75rem;" @onclick="CancelarEdicaoAluno">Cancelar</button>
                                <button class="btn btn-success btn-sm rounded-pill px-3 py-1" style="font-size: 0.75rem;" @onclick="SalvarAlteracoesAluno">💾 Salvar</button>
                            </div>
                        }
                    </div>

                    <div class="row g-2 mb-4 bg-light p-3 rounded-4 border">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Nome do Aluno</label>
                            <input type="text" class="form-control rounded-pill" @bind="alunoTemp.Nome" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">URL da Foto</label>
                            <input type="text" class="form-control rounded-pill" @bind="alunoTemp.FotoUrl" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Responsável Principal</label>
                            <input type="text" class="form-control rounded-pill" @bind="alunoTemp.NomeResponsavel" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Telefone / WhatsApp</label>
                            <input type="text" class="form-control rounded-pill" @bind="alunoTemp.TelefoneResponsavel" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Endereço Residencial</label>
                            <input type="text" class="form-control rounded-pill" @bind="alunoTemp.Endereco" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Mensalidade (R$)</label>
                            <input type="number" step="0.01" class="form-control rounded-pill" @bind="alunoTemp.ValorMensalidade" disabled="@(!editandoAluno)" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Vínculo</label>
                            <select class="form-select rounded-pill" @bind="alunoTemp.ConvenioPrefeitura" disabled="@(!editandoAluno)">
                                <option value="false">Particular</option>
                                <option value="true">Prefeitura</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Turno</label>
                            <select class="form-select rounded-pill" @bind="alunoTemp.TurnoAluno" disabled="@(!editandoAluno)">
                                <option value="Matutino">Matutino</option>
                                <option value="Vespertino">Vespertino</option>
                                <option value="Integral">Integral</option>
                            </select>
                        </div>
                    </div>

                    <!-- SEÇÃO DE PESSOAS AUTORIZADAS A RETIRAR -->
                    <div class="mb-4 pt-2 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark m-0 fs-6">🛡️ Autorizados a Retirar</h6>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1" style="font-size: 0.75rem;" @onclick="AbrirModalNovoAutorizado">
                                + Adicionar
                            </button>
                        </div>

                        <div class="row g-2">
                            @if (listaAutorizadosAluno == null || listaAutorizadosAluno.Count == 0)
                            {
                                <div class="col-12">
                                    <p class="text-muted small text-center py-2 bg-light rounded-pill">Nenhum autorizado extra cadastrado.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var auth in listaAutorizadosAluno)
                                {
                                    <div class="col-12 col-md-6">
                                        <div class="card border shadow-none rounded-4 p-2 bg-white h-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center gap-2">
                                                    <img src="@(string.IsNullOrEmpty(auth.FotoUrl) ? "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80" : auth.FotoUrl)" class="rounded-circle border" style="width: 35px; height: 35px; object-fit: cover;" />
                                                    <div>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <h6 class="fw-bold text-dark m-0" style="font-size: 0.8rem;">@auth.Nome</h6>
                                                            @if (auth.Temporario)
                                                            {
                                                                <span class="badge bg-warning text-dark px-1 py-0.5" style="font-size: 0.55rem;">Temp</span>
                                                            }
                                                        </div>
                                                        <small class="text-muted d-block" style="font-size: 0.68rem;">@auth.Parentesco | @auth.Telefone</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-1 align-items-center">
                                                    <button type="button" class="btn btn-xs @(auth.PodeRetirar ? "btn-outline-success" : "btn-outline-danger") rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => AlternarStatusRetirada(auth)">
                                                        @(auth.PodeRetirar ? "Liberado" : "Bloqueado")
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0.5" style="font-size: 0.65rem;" @onclick="() => EditarAutorizado(auth)">✏️</button>
                                                    @if (!auth.Principal)
                                                    {
                                                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-1.5 py-0.5" style="font-size: 0.65rem;" @onclick="() => RemoverAutorizado(auth.Id)">✕</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2 fs-6">💵 Histórico de Boletos (@DateTime.Now.Year)</h6>
                    <div class="table-responsive border rounded-4 overflow-hidden">
                        <table class="table table-sm align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mês</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                    <th class="text-end pe-3">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in boletosAlunoTemp)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@b.Mes</td>
                                        <td>R$ @b.Valor.ToString("N2")</td>
                                        <td>
                                            @if (b.Pago)
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-0.5 rounded-pill">🟢 Pago</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-0.5 rounded-pill">🔴 Pendente</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (!b.Pago)
                                            {
                                                <button class="btn btn-xs btn-outline-success rounded-pill px-2 py-0.5" style="font-size: 0.7rem;" @onclick="() => BaixarBoleto(b)">Baixar</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0.5" style="font-size: 0.7rem;" @onclick="() => EstornarBoleto(b)">Estornar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => exibirModalFicha = false">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL CADASTRAR OU EDITAR AUTORIZADO -->
@if (exibirModalAutorizado)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6); z-index: 2050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered mx-2 mx-md-auto">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title fw-bold fs-6">@(autorizadoEdit.Id == 0 ? "➕ Adicionar Autorizado" : "✏️ Editar Autorizado")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalAutorizado = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nome Completo</label>
                        <input type="text" class="form-control rounded-pill" @bind="autorizadoEdit.Nome" placeholder="Ex: Tio Roberto" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Telefone</label>
                            <input type="text" class="form-control rounded-pill" @bind="autorizadoEdit.Telefone" placeholder="(41) 99999-9999" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Parentesco</label>
                            <select class="form-select rounded-pill" @bind="autorizadoEdit.Parentesco">
                                <option value="Pai / Mãe">Pai / Mãe</option>
                                <option value="Avô / Avó">Avô / Avó</option>
                                <option value="Tio / Tia">Tio / Tia</option>
                                <option value="Irmão(ã) Maior">Irmão(ã) Maior</option>
                                <option value="Babá / Cuidador(a)">Babá / Cuidador(a)</option>
                                <option value="Outro">Outro</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Endereço</label>
                        <input type="text" class="form-control rounded-pill" @bind="autorizadoEdit.Endereco" placeholder="Endereço..." />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">URL da Foto</label>
                        <input type="text" class="form-control rounded-pill" @bind="autorizadoEdit.FotoUrl" placeholder="https://..." />
                    </div>

                    <div class="row g-2 mb-2 p-3 bg-light rounded-4 border">
                        <div class="col-12 mb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="checkPodeRetirar" @bind="autorizadoEdit.PodeRetirar" />
                                <label class="form-check-input-label fw-bold text-dark small" for="checkPodeRetirar">
                                    @(autorizadoEdit.PodeRetirar ? "🟢 Liberado para Retirar" : "🔴 Bloqueado")
                                </label>
                            </div>
                        </div>
                        <div class="col-12 border-top pt-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="checkTemporario" @bind="autorizadoEdit.Temporario" />
                                <label class="form-check-input-label fw-bold text-dark small" for="checkTemporario">
                                    Acesso Temporário (Período Fechado)
                                </label>
                            </div>
                        </div>

                        @if (autorizadoEdit.Temporario)
                        {
                            <div class="col-6 mt-2">
                                <label class="form-label small fw-semibold">Data Início</label>
                                <input type="date" class="form-control form-control-sm rounded-pill" @bind="autorizadoEdit.DataInicio" />
                            </div>
                            <div class="col-6 mt-2">
                                <label class="form-label small fw-semibold">Data Fim</label>
                                <input type="date" class="form-control form-control-sm rounded-pill" @bind="autorizadoEdit.DataFim" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => exibirModalAutorizado = false">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold" @onclick="SalvarAutorizado">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL NOVO ALUNO -->
@if (exibirModalNovoAluno)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered mx-2 mx-md-auto">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold fs-6">👶 Matricular Novo Aluno</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalNovoAluno = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nome do Aluno</label>
                        <input type="text" class="form-control rounded-pill" @bind="novoAluno.Nome" placeholder="Nome completo..." />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Responsável</label>
                            <input type="text" class="form-control rounded-pill" @bind="novoAluno.NomeResponsavel" placeholder="Pai/Mãe..." />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Telefone</label>
                            <input type="text" class="form-control rounded-pill" @bind="novoAluno.TelefoneResponsavel" placeholder="(41) 99999-9999" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vínculo</label>
                            <select class="form-select rounded-pill" @bind="novoAluno.ConvenioPrefeitura">
                                <option value="false">Particular</option>
                                <option value="true">Prefeitura</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Turno</label>
                            <select class="form-select rounded-pill" @bind="novoAluno.TurnoAluno">
                                <option value="Matutino">Matutino</option>
                                <option value="Vespertino">Vespertino</option>
                                <option value="Integral">Integral</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Mensalidade (R$)</label>
                        <input type="number" step="0.01" class="form-control rounded-pill" @bind="novoAluno.ValorMensalidade" />
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => exibirModalNovoAluno = false">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold" @onclick="SalvarNovoAluno">Matricular</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int TurmaId { get; set; }
    private Turma turma = new();
    
    private decimal receitaEfetivaTurma = 0;
    private decimal receitaPrevisaoTurma = 0;
    private int inadimplentesTurma = 0;
    private string mensagemSucesso = string.Empty;

    private bool exibirModalFicha = false;
    private bool editandoAluno = false;
    private Aluno? alunoSelecionado;
    private Aluno alunoTemp = new();

    private bool exibirModalNovoAluno = false;
    private Aluno novoAluno = new() { ValorMensalidade = 350.00m, MensalidadeMesPaga = true, TurnoAluno = "Integral" };

    private List<Responsavel> listaAutorizadosAluno = new();
    private bool exibirModalAutorizado = false;
    private Responsavel autorizadoEdit = new() { PodeRetirar = true };

    public class BoletoItem
    {
        public string Mes { get; set; } = string.Empty;
        public decimal Valor { get; set; }
        public bool Pago { get; set; }
    }
    private List<BoletoItem> boletosAlunoTemp = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosTurma();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private async Task CarregarDadosTurma()
    {
        var t = await Db.Turmas
            .Include(x => x.Alunos)
            .Include(x => x.Escola)
            .FirstOrDefaultAsync(x => x.Id == TurmaId);

        if (t != null) turma = t;

        receitaPrevisaoTurma = 0;
        receitaEfetivaTurma = 0;
        inadimplentesTurma = 0;

        if (turma.Alunos != null)
        {
            foreach (var a in turma.Alunos)
            {
                receitaPrevisaoTurma += a.ValorMensalidade;
                if (a.MensalidadeMesPaga)
                {
                    receitaEfetivaTurma += a.ValorMensalidade;
                }
                else
                {
                    inadimplentesTurma++;
                }
            }
        }
    }

    private async Task AbrirModalFicha(Aluno aluno)
    {
        alunoSelecionado = aluno;
        CopiarAlunoParaTemp();
        editandoAluno = false;

        await CarregarAutorizadosAluno(aluno.Id);

        boletosAlunoTemp.Clear();
        string[] meses = { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
        int mesAtualIdx = DateTime.Now.Month - 1;

        for (int i = 0; i < meses.Length; i++)
        {
            bool pago = i < mesAtualIdx ? true : (i == mesAtualIdx ? aluno.MensalidadeMesPaga : false);
            boletosAlunoTemp.Add(new BoletoItem { Mes = meses[i], Valor = aluno.ValorMensalidade, Pago = pago });
        }

        exibirModalFicha = true;
    }

    private async Task CarregarAutorizadosAluno(int alunoId)
    {
        listaAutorizadosAluno = await Db.Responsaveis
            .Where(r => r.AlunoId == alunoId)
            .ToListAsync();
    }

    private void AbrirModalNovoAutorizado()
    {
        autorizadoEdit = new Responsavel 
        { 
            PodeRetirar = true, 
            DataInicio = DateTime.Today, 
            DataFim = DateTime.Today.AddDays(7) 
        };
        exibirModalAutorizado = true;
    }

    private void EditarAutorizado(Responsavel auth)
    {
        autorizadoEdit = new Responsavel
        {
            Id = auth.Id,
            Nome = auth.Nome,
            Telefone = auth.Telefone,
            Endereco = auth.Endereco,
            Parentesco = auth.Parentesco,
            FotoUrl = auth.FotoUrl,
            PodeRetirar = auth.PodeRetirar,
            Temporario = auth.Temporario,
            DataInicio = auth.DataInicio ?? DateTime.Today,
            DataFim = auth.DataFim ?? DateTime.Today.AddDays(7),
            Principal = auth.Principal,
            AlunoId = auth.AlunoId
        };
        exibirModalAutorizado = true;
    }

    private async Task SalvarAutorizado()
    {
        if (alunoSelecionado != null && !string.IsNullOrWhiteSpace(autorizadoEdit.Nome))
        {
            if (autorizadoEdit.Id == 0)
            {
                autorizadoEdit.AlunoId = alunoSelecionado.Id;
                if (string.IsNullOrEmpty(autorizadoEdit.FotoUrl))
                {
                    autorizadoEdit.FotoUrl = "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80";
                }
                Db.Responsaveis.Add(autorizadoEdit);
            }
            else
            {
                var existente = await Db.Responsaveis.FindAsync(autorizadoEdit.Id);
                if (existente != null)
                {
                    existente.Nome = autorizadoEdit.Nome;
                    existente.Telefone = autorizadoEdit.Telefone;
                    existente.Endereco = autorizadoEdit.Endereco;
                    existente.Parentesco = autorizadoEdit.Parentesco;
                    existente.FotoUrl = autorizadoEdit.FotoUrl;
                    existente.PodeRetirar = autorizadoEdit.PodeRetirar;
                    existente.Temporario = autorizadoEdit.Temporario;
                    existente.DataInicio = autorizadoEdit.DataInicio;
                    existente.DataFim = autorizadoEdit.DataFim;
                    Db.Responsaveis.Update(existente);
                }
            }

            await Db.SaveChangesAsync();
            exibirModalAutorizado = false;
            await CarregarAutorizadosAluno(alunoSelecionado.Id);
            mensagemSucesso = "Dados do autorizado salvos com sucesso!";
        }
    }

    private async Task AlternarStatusRetirada(Responsavel auth)
    {
        auth.PodeRetirar = !auth.PodeRetirar;
        Db.Responsaveis.Update(auth);
        await Db.SaveChangesAsync();
    }

    private async Task RemoverAutorizado(int id)
    {
        var item = await Db.Responsaveis.FindAsync(id);
        if (item != null && !item.Principal)
        {
            Db.Responsaveis.Remove(item);
            await Db.SaveChangesAsync();
            if (alunoSelecionado != null)
            {
                await CarregarAutorizadosAluno(alunoSelecionado.Id);
            }
        }
    }

    private void CopiarAlunoParaTemp()
    {
        if (alunoSelecionado != null)
        {
            alunoTemp = new Aluno
            {
                Id = alunoSelecionado.Id,
                Nome = alunoSelecionado.Nome,
                FotoUrl = alunoSelecionado.FotoUrl,
                Endereco = alunoSelecionado.Endereco,
                NomeResponsavel = alunoSelecionado.NomeResponsavel,
                TelefoneResponsavel = alunoSelecionado.TelefoneResponsavel,
                ConvenioPrefeitura = alunoSelecionado.ConvenioPrefeitura,
                TurnoAluno = alunoSelecionado.TurnoAluno,
                ValorMensalidade = alunoSelecionado.ValorMensalidade,
                LoginPortal = alunoSelecionado.LoginPortal,
                SenhaPortal = alunoSelecionado.SenhaPortal,
                MensalidadeMesPaga = alunoSelecionado.MensalidadeMesPaga,
                TurmaId = alunoSelecionado.TurmaId
            };
        }
    }

    private void CancelarEdicaoAluno()
    {
        CopiarAlunoParaTemp();
        editandoAluno = false;
    }

    private async Task SalvarAlteracoesAluno()
    {
        if (alunoSelecionado != null)
        {
            alunoSelecionado.Nome = alunoTemp.Nome;
            alunoSelecionado.FotoUrl = alunoTemp.FotoUrl;
            alunoSelecionado.Endereco = alunoTemp.Endereco;
            alunoSelecionado.NomeResponsavel = alunoTemp.NomeResponsavel;
            alunoSelecionado.TelefoneResponsavel = alunoTemp.TelefoneResponsavel;
            alunoSelecionado.ConvenioPrefeitura = alunoTemp.ConvenioPrefeitura;
            alunoSelecionado.TurnoAluno = alunoTemp.TurnoAluno;
            alunoSelecionado.ValorMensalidade = alunoTemp.ValorMensalidade;

            Db.Alunos.Update(alunoSelecionado);
            await Db.SaveChangesAsync();
            editandoAluno = false;
            mensagemSucesso = "Ficha do aluno atualizada com sucesso!";
            await CarregarDadosTurma();
        }
    }

    private void BaixarBoleto(BoletoItem b)
    {
        b.Pago = true;
        if (b.Mes == DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("pt-BR")) && alunoSelecionado != null)
        {
            alunoSelecionado.MensalidadeMesPaga = true;
            Db.Alunos.Update(alunoSelecionado);
            Db.SaveChanges();
        }
        StateHasChanged();
    }

    private void EstornarBoleto(BoletoItem b)
    {
        b.Pago = false;
        if (b.Mes == DateTime.Now.ToString("MMMM", new System.Globalization.CultureInfo("pt-BR")) && alunoSelecionado != null)
        {
            alunoSelecionado.MensalidadeMesPaga = false;
            Db.Alunos.Update(alunoSelecionado);
            Db.SaveChanges();
        }
        StateHasChanged();
    }

    private void AbrirModalNovoAluno() => exibirModalNovoAluno = true;

    private async Task SalvarNovoAluno()
    {
        novoAluno.TurmaId = TurmaId;
        if (string.IsNullOrEmpty(novoAluno.LoginPortal))
        {
            novoAluno.LoginPortal = $"pai_{Guid.NewGuid().ToString().Substring(0, 5)}";
            novoAluno.SenhaPortal = "123456";
        }
        Db.Alunos.Add(novoAluno);
        await Db.SaveChangesAsync();
        exibirModalNovoAluno = false;
        novoAluno = new Aluno { ValorMensalidade = 350.00m, MensalidadeMesPaga = true, TurnoAluno = "Integral" };
        mensagemSucesso = "Aluno matriculado com sucesso!";
        await CarregarDadosTurma();
    }

    private void VoltarPainelEscola() => Navigation.NavigateTo($"/escola/gerenciar/{turma.EscolaId}");
}