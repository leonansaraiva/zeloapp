@page "/escola/turma/{TurmaId:int}"
@rendermode InteractiveServer
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Gerenciar Turma: @turma.Nome</PageTitle>

<div class="container-fluid px-3 px-md-4 py-3">
    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2" @onclick="VoltarPainelEscola">← Voltar para a Unidade</button>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold text-dark m-0 fs-3">📁 Turma: @turma.Nome</h2>
                <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-1 rounded-pill">Turno: @turma.Turno</span>
            </div>
            <p class="text-muted small m-0 mt-1">
                📅 Vigência: <strong>@(turma.DataInicioVigencia?.ToString("dd/MM/yyyy") ?? "-")</strong> até <strong>@(turma.DataFimVigencia?.ToString("dd/MM/yyyy") ?? "-")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/escola/turma/@turma.Id/matricular" class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm btn-sm text-decoration-none">
                + Matricular Aluno
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-4 p-3 shadow-sm mb-4">✅ @mensagemSucesso</div>
    }

    <!-- ABAS DE NAVEGAÇÃO DA TURMA -->
    <ul class="nav nav-pills gap-2 mb-4">
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold @(abaAtiva == "alunos" ? "active bg-primary text-white" : "bg-white text-dark border")" @onclick='() => abaAtiva = "alunos"'>
                👶 Alunos Matriculados (@(turma.Alunos?.Count ?? 0))
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold @(abaAtiva == "planejamento" ? "active bg-primary text-white" : "bg-white text-dark border")" @onclick='() => abaAtiva = "planejamento"'>
                📝 Planejamento & Vigência
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold @(abaAtiva == "historico" ? "active bg-primary text-white" : "bg-white text-dark border")" @onclick='() => abaAtiva = "historico"'>
                📜 Histórico / Auditoria
            </button>
        </li>
    </ul>

    <!-- CONTEÚDO DA ABA: ALUNOS -->
    @if (abaAtiva == "alunos")
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            <div class="card-header bg-white p-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark m-0 fs-6">Alunos da Turma</h5>
                <span class="badge bg-secondary rounded-pill px-3 py-1">Total: @(turma.Alunos?.Count ?? 0)</span>
            </div>

            @if (turma.Alunos == null || turma.Alunos.Count == 0)
            {
                <div class="text-center p-5">
                    <p class="text-muted small">Nenhum aluno matriculado nesta turma ainda.</p>
                    <a href="/escola/turma/@turma.Id/matricular" class="btn btn-primary btn-sm rounded-pill px-3 text-decoration-none">+ Matricular Primeiro Aluno</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0 small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-3">Aluno(a)</th>
                                <th>Vínculo</th>
                                <th>Turno</th>
                                <th>Responsável</th>
                                <th>Mensalidade</th>
                                <th class="text-end pe-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aluno in turma.Alunos)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(aluno.FotoUrl) ? "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=150&auto=format&fit=crop&q=80" : aluno.FotoUrl)" class="rounded-circle border shadow-sm" style="width: 32px; height: 32px; object-fit: cover;" />
                                            <span class="fw-bold text-dark">@aluno.NomeCompleto</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(aluno.Vinculo == "Prefeitura" ? "bg-info-subtle text-info" : "bg-secondary-subtle text-dark") px-2 py-0.5 rounded-pill fw-semibold">
                                            @aluno.Vinculo
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border px-2 py-0.5">@aluno.Turno</span></td>
                                    <td>
                                        <div class="text-dark">@(aluno.Responsavel?.NomeCompleto ?? "Não informado")</div>
                                        <small class="text-muted">@(aluno.Responsavel?.Telefone ?? "-")</small>
                                    </td>
                                    <td><span class="fw-bold text-success">R$ @aluno.ValorMensalidade.ToString("N2")</span></td>
                                    <td class="text-end pe-3">
                                        <a href="/escola/aluno/@aluno.Id" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 text-decoration-none" style="font-size: 0.75rem;">
                                            Gerenciar Ficha →
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- CONTEÚDO DA ABA: PLANEJAMENTO E VIGÊNCIA -->
    else if (abaAtiva == "planejamento")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4" style="max-width: 800px;">
            <h5 class="fw-bold text-dark mb-3 fs-6">📝 Configurações de Vigência e Diário</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Início do Período Letivo</label>
                    <input type="date" class="form-control rounded-pill" @bind="turma.DataInicioVigencia" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Término do Período Letivo</label>
                    <input type="date" class="form-control rounded-pill" @bind="turma.DataFimVigencia" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold">Resumo / Planejamento Pedagógico / Diário da Turma</label>
                    <textarea class="form-control rounded-4" rows="4" @bind="turma.ResumoPlanejamento" placeholder="Escreva aqui as diretrizes da turma, projetos pedagógicos ou recados gerais..."></textarea>
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <button class="btn btn-success rounded-pill px-4 fw-semibold btn-sm" @onclick="SalvarPlanejamento">💾 Salvar Alterações</button>
            </div>
        </div>
    }

    <!-- CONTEÚDO DA ABA: HISTÓRICO / AUDITORIA -->
    else if (abaAtiva == "historico")
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" style="max-width: 800px;">
            <h5 class="fw-bold text-dark mb-3 fs-6">📜 Log de Auditoria & Movimentações</h5>
            <p class="text-muted small">Registro cronológico de todas as ações operacionais ocorridas nesta turma.</p>

            <div class="timeline border-start ps-3 ms-2 d-flex flex-column gap-3">
                @if (turma.Historicos == null || turma.Historicos.Count == 0)
                {
                    <div class="text-muted small">Nenhuma movimentação registrada até o momento. A criação da turma foi o marco inicial.</div>
                }
                else
                {
                    @foreach (var h in turma.Historicos.OrderByDescending(x => x.DataHora))
                    {
                        <div class="position-relative">
                            <span class="position-absolute bg-primary rounded-circle" style="width: 10px; height: 10px; left: -21px; top: 5px;"></span>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">@h.DataHora.ToString("dd/MM/yyyy HH:mm") • <strong class="text-dark">@h.Tipo</strong></small>
                            <span class="text-dark small fw-semibold">@h.Descricao</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int TurmaId { get; set; }
    private Turma turma = new();
    private string abaAtiva = "alunos";
    private string mensagemSucesso = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        var t = await Db.Turmas
            .Include(x => x.Alunos)
                .ThenInclude(a => a.Responsavel)
            .Include(x => x.Historicos)
            .FirstOrDefaultAsync(x => x.Id == TurmaId);

        if (t != null)
        {
            turma = t;
        }
    }

    private async Task SalvarPlanejamento()
    {
        Db.Turmas.Update(turma);
        
        // Adiciona registro no histórico de auditoria
        Db.HistoricoMovimentacoes.Add(new HistoricoMovimentacao        {
            TurmaId = turma.Id,
            Tipo = "Planejamento",
            Descricao = "O planejamento pedagógico ou período de vigência foi atualizado pela direção."
        });

        await Db.SaveChangesAsync();
        mensagemSucesso = "Planejamento e vigência atualizados com sucesso!";
        await CarregarDados();
    }

    private void VoltarPainelEscola() => Navigation.NavigateTo($"/escola/gerenciar/{turma.EscolaId}");
}