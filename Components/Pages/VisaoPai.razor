@page "/portal/pai"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Portal da Família</PageTitle>

@if (crianca == null)
{
    <div class="container mt-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="container py-4">
        <!-- Banner Superior -->
        <div class="p-3 bg-primary text-white rounded shadow-sm mb-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <img src="@responsavelLogado?.FotoUrl" class="rounded-circle border border-2 border-white" width="50" height="50" style="object-fit: cover;" />
                <div>
                    <h5 class="m-0 fw-bold">📱 Portal da Família - Zelo</h5>
                    <small>Usuário: @responsavelLogado?.Nome (Responsável Titular)</small>
                </div>
            </div>
            <span class="badge bg-light text-primary fw-bold">Escola Pequeno Anjo</span>
        </div>

        <div class="row g-4">
            <!-- Card da Criança -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm text-center p-4">
                    <img src="@crianca.FotoUrl" class="rounded-circle mx-auto mb-3 border border-3 border-primary shadow-sm" width="130" height="130" style="object-fit: cover;" />
                    <h4 class="fw-bold m-0 text-dark">@crianca.Nome</h4>
                    <p class="text-muted small my-1">Data Nasc: @crianca.DataNascimento.ToShortDateString()</p>
                    <span class="badge bg-light text-primary border mx-auto px-3 py-2">Turma: Berçário I</span>
                </div>
            </div>

            <!-- Lista de Responsáveis Cadastrados -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                        <h5 class="fw-bold m-0 text-dark">👥 Responsáveis Cadastrados</h5>
                        <button class="btn btn-primary btn-sm fw-semibold" @onclick="AbrirModalNovo">+ Cadastrar Responsável</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var resp in crianca.Responsaveis)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@resp.FotoUrl" class="rounded-circle border" width="50" height="50" style="object-fit: cover;" />
                                        <div>
                                            <h6 class="m-0 fw-bold">@resp.Nome @(resp.Principal ? "⭐" : "")</h6>
                                            <small class="text-muted d-block">@resp.Parentesco • CPF: @resp.Cpf</small>
                                            @if (resp.EhTemporario)
                                            {
                                                <small class="text-warning fw-bold">⏱️ Temporário: @resp.DataInicioRetirada?.ToShortDateString() até @resp.DataFimRetirada?.ToShortDateString()</small>
                                            }
                                            else
                                            {
                                                <small class="text-success">♾️ Permissão Permanente</small>
                                            }
                                        </div>
                                    </div>
                                    <div>
                                        @if (resp.Principal)
                                        {
                                            <span class="badge bg-primary">Titular Principal</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm @(resp.PodeRetirar ? "btn-success" : "btn-outline-danger")" @onclick="() => AlternarPermissao(resp)">
                                                @(resp.PodeRetirar ? "✅ Pode Retirar" : "🚫 Retirada Bloqueada")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE CADASTRO COM AVATAR NO TOPO E GUIA DE BIOMETRIA -->
    @if (exibirModal)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">➕ Cadastrar Responsável Autorizado</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                    </div>
                    <EditForm Model="novoResponsavel" OnValidSubmit="SalvarResponsavel">
                        <DataAnnotationsValidator />
                        <div class="modal-body p-4">
                            
                            <!-- SEÇÃO SUPERIOR: FOTO / RECONHECIMENTO FACIAL -->
                            <div class="row bg-light rounded p-3 mb-4 align-items-center border">
                                <div class="col-md-4 text-center">
                                    <div class="position-relative d-inline-block">
                                        <!-- Avatar estilizado com moldura de biometria -->
                                        <div class="rounded-circle border border-3 border-primary d-flex align-items-center justify-content-center bg-white shadow-sm mx-auto" style="width: 110px; height: 110px; overflow: hidden;">
                                            @if (string.IsNullOrEmpty(novoResponsavel.FotoUrl) || novoResponsavel.FotoUrl.Contains("placeholder"))
                                            {
                                                <span class="fs-1 text-secondary">👤</span>
                                            }
                                            else
                                            {
                                                <img src="@novoResponsavel.FotoUrl" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                        </div>
                                        <!-- Ícone/Botão de Câmera sobreposto -->
                                        <span class="position-absolute bottom-0 end-0 bg-primary text-white p-2 rounded-circle border border-white shadow-sm" style="cursor: pointer;" title="Clique para enviar/capturar foto">
                                            📷
                                        </span>
                                    </div>
                                    <small class="d-block text-primary fw-semibold mt-2">Toque para enviar a foto</small>
                                </div>

                                <div class="col-md-8">
                                    <div class="alert alert-info border-0 mb-0 py-2 small">
                                        <strong class="d-block text-dark mb-1">📸 Requisitos para Reconhecimento Facial:</strong>
                                        <ul class="mb-0 ps-3 text-muted">
                                            <li>Foto frontal, enquadramento acima dos ombros.</li>
                                            <li>Olhar fixo para a câmera e boa iluminação.</li>
                                            <li>Sem óculos escuros, chapéu, boné ou máscaras.</li>
                                            <li>O responsável cadastrado deve ser <strong>+18 anos</strong>.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- CAMPOS DO FORMULÁRIO -->
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label font-semibold">Nome Completo</label>
                                    <InputText class="form-control" @bind-Value="novoResponsavel.Nome" placeholder="Ex: Roberto Silva" />
                                    <ValidationMessage For="@(() => novoResponsavel.Nome)" class="text-danger small" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label font-semibold">CPF</label>
                                    <InputText class="form-control" @bind-Value="novoResponsavel.Cpf" placeholder="000.000.000-00" />
                                    <ValidationMessage For="@(() => novoResponsavel.Cpf)" class="text-danger small" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label font-semibold">Grau de Parentesco</label>
                                    <InputSelect class="form-select" @bind-Value="novoResponsavel.Parentesco">
                                        <option value="Mãe">Mãe</option>
                                        <option value="Pai">Pai</option>
                                        <option value="Avó/Avô">Avó / Avô</option>
                                        <option value="Tio/Tia">Tio / Tia</option>
                                        <option value="Padrinho/Madrinha">Padrinho / Madrinha</option>
                                        <option value="Primo/Prima (+18)">Primo / Prima (Maior de 18 anos)</option>
                                        <option value="Irmão/Irmã (+18)">Irmão / Irmã (Maior de 18 anos)</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label font-semibold">Telefone de Contato</label>
                                    <InputText class="form-control" @bind-Value="novoResponsavel.Telefone" placeholder="(41) 99999-0000" />
                                </div>

                                <div class="col-md-12">
                                    <hr class="my-2" />
                                    <h6 class="fw-bold text-dark mb-2">🗓️ Tipo e Período de Permissão de Retirada</h6>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" id="permPermanente" name="tipoPerm" checked="@(!novoResponsavel.EhTemporario)" @onchange="@(() => novoResponsavel.EhTemporario = false)" />
                                        <label class="form-check-label fw-bold" for="permPermanente">Permanente</label>
                                    </div>
                                    <div class="form-check form-check-inline ms-3">
                                        <input class="form-check-input" type="radio" id="permTemp" name="tipoPerm" checked="@(novoResponsavel.EhTemporario)" @onchange="@(() => novoResponsavel.EhTemporario = true)" />
                                        <label class="form-check-label fw-bold text-warning" for="permTemp">Temporário (Período Específico)</label>
                                    </div>
                                </div>

                                @if (novoResponsavel.EhTemporario)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label font-semibold">Data de Início</label>
                                        <InputDate class="form-control" @bind-Value="novoResponsavel.DataInicioRetirada" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label font-semibold">Data de Término</label>
                                        <InputDate class="form-control" @bind-Value="novoResponsavel.DataFimRetirada" />
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold px-4">Cadastrar Responsável</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@code {
    private Crianca? crianca;
    private Responsavel? responsavelLogado;
    private Responsavel novoResponsavel = new();
    private bool exibirModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        crianca = await Db.Criancas
            .Include(c => c.Responsaveis)
            .FirstOrDefaultAsync();

        if (crianca != null)
        {
            responsavelLogado = crianca.Responsaveis.FirstOrDefault(r => r.Principal);
        }
    }

    private void AbrirModalNovo()
    {
        novoResponsavel = new Responsavel 
        { 
            CriancaId = crianca!.Id, 
            PodeRetirar = true,
            EhTemporario = false,
            DataInicioRetirada = DateTime.Today,
            DataFimRetirada = DateTime.Today.AddDays(1),
            FotoUrl = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80"
        };
        exibirModal = true;
    }

    private void FecharModal() => exibirModal = false;

    private async Task SalvarResponsavel()
    {
        Db.Responsaveis.Add(novoResponsavel);
        await Db.SaveChangesAsync();
        exibirModal = false;
        await CarregarDados();
    }

    private async Task AlternarPermissao(Responsavel resp)
    {
        resp.PodeRetirar = !resp.PodeRetirar;
        await Db.SaveChangesAsync();
    }
}