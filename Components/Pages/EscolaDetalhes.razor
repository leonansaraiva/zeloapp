@page "/superadmin/escolas/{Id:int}"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container py-4" style="max-width: 900px;">
    <!-- Topo -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/superadmin/escolas" class="btn btn-outline-secondary btn-sm rounded-3 px-3">← Voltar para Escolas</a>
        <button class="btn btn-danger btn-sm rounded-3 px-3" @onclick="ExcluirEscola">🗑️ Excluir Escola</button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger rounded-3 p-3 small mb-4 shadow-sm">⚠️ @mensagemErro</div>
    }

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-3 p-3 small mb-4 shadow-sm">✅ @mensagemSucesso</div>
    }

    @if (escola == null)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted">Carregando informações da escola...</div>
    }
    else
    {
        <!-- Cabeçalho da Escola -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h3 class="fw-bold text-dark m-0">🏫 @escola.Nome</h3>
                    <p class="text-muted small mt-1 mb-2">CNPJ: @escola.Cnpj | Gestor: <strong>@escola.NomeGestor</strong></p>
                    <span class="badge bg-light text-dark border">Login da Diretora: <strong>@escola.LoginAdmin</strong></span>
                </div>
                <div class="text-end">
                    <button class="btn btn-primary btn-sm rounded-3 px-3 fw-semibold mb-2 d-block" @onclick="() => exibirModalTurma = true">+ Nova Turma</button>
                    <button class="btn btn-success btn-sm rounded-3 px-3 fw-semibold d-block" @onclick="() => exibirModalAluno = true">+ Matricular Aluno</button>
                </div>
            </div>
        </div>

        <!-- Turmas e Alunos -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold m-0 text-dark">🎒 Turmas e Alunos Matriculados</h5>
                <span class="badge bg-primary rounded-pill px-3 py-2">Total na Escola: @totalAlunosGeral alunos</span>
            </div>

            @if (turmasComAlunos == null || !turmasComAlunos.Any())
            {
                <div class="text-muted text-center py-4 small">Nenhuma turma cadastrada nesta escola ainda. Clique em "+ Nova Turma" acima.</div>
            }
            else
            {
                @foreach (var item in turmasComAlunos)
                {
                    <div class="card border rounded-4 p-3 mb-3 bg-light shadow-none">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="fw-bold text-dark m-0">📚 @item.Turma.Nome <span class="badge bg-secondary ms-2" style="font-size: 0.7rem;">@item.Turma.Turno</span></h6>
                                <small class="text-muted">Educadora: @item.Turma.EducadoraResponsavel</small>
                            </div>
                            <span class="badge bg-primary rounded-pill">@item.AlunosComTitular.Count alunos</span>
                        </div>

                        @if (item.AlunosComTitular.Any())
                        {
                            <div class="list-group list-group-flush mt-2 rounded-3 overflow-hidden border">
                                @foreach (var dto in item.AlunosComTitular)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center bg-white px-3 py-2">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(dto.Crianca.FotoUrl) ? "https://images.unsplash.com/photo-1543332164-6e82f355badc?w=150&auto=format&fit=crop&q=80" : dto.Crianca.FotoUrl)" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                                            <div>
                                                <span class="fw-semibold text-dark d-block">@dto.Crianca.Nome</span>
                                                <small class="text-muted">Titular: <strong>@(dto.Titular?.Nome ?? "Não informado")</strong> • Tel: @(dto.Titular?.Telefone ?? "-")</small>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary rounded-3 px-3" @onclick="() => VerDetalhesAluno(dto.Crianca.Id)">
                                            Ver Ficha →
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    <!-- MODAL: CADASTRAR TURMA -->
    @if (exibirModalTurma)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header bg-primary text-white rounded-top-4">
                        <h5 class="modal-title fw-bold">➕ Nova Turma</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalTurma = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nome da Turma</label>
                            <input type="text" class="form-control rounded-3" @bind="novaTurma.Nome" placeholder="Ex: Maternal II A" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Turno</label>
                            <select class="form-select rounded-3" @bind="novaTurma.Turno">
                                <option value="Matutino">Matutino</option>
                                <option value="Vespertino">Vespertino</option>
                                <option value="Integral">Integral</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Educadora Responsável</label>
                            <input type="text" class="form-control rounded-3" @bind="novaTurma.EducadoraResponsavel" placeholder="Ex: Prof.ª Maria" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3 pt-0">
                        <button type="button" class="btn btn-light rounded-3 px-3 btn-sm" @onclick="() => exibirModalTurma = false">Cancelar</button>
                        <button type="button" class="btn btn-primary rounded-3 px-4 btn-sm fw-semibold" @onclick="SalvarTurma">Salvar Turma</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: MATRICULAR ALUNO E RESPONSÁVEL -->
    @if (exibirModalAluno)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header bg-success text-white rounded-top-4">
                        <h5 class="modal-title fw-bold">👶 Matricular Aluno & Responsável</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalAluno = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <h6 class="fw-bold text-primary mb-3">1. Dados da Criança</h6>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nome Completo do Aluno</label>
                            <input type="text" class="form-control rounded-3" @bind="novoAluno.Nome" placeholder="Ex: Lucas Gabriel" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Data de Nascimento (Senha do Portal)</label>
                            <input type="date" class="form-control rounded-3" @bind="novoAluno.DataNascimento" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Selecione a Turma</label>
                            <select class="form-select rounded-3" @bind="turmaSelecionadaId">
                                <option value="0">Selecione...</option>
                                @foreach (var t in turmasDisponiveis)
                                {
                                    <option value="@t.Id">@t.Nome (@t.Turno)</option>
                                }
                            </select>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-success mb-3">2. Responsável Titular (Contrato)</h6>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nome do Responsável</label>
                            <input type="text" class="form-control rounded-3" @bind="novoResponsavel.Nome" placeholder="Ex: Carlos Silva" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">CPF (Login no Portal do Pai)</label>
                            <input type="text" class="form-control rounded-3" @bind="novoResponsavel.Cpf" placeholder="000.000.000-00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Telefone / WhatsApp</label>
                            <input type="text" class="form-control rounded-3" @bind="novoResponsavel.Telefone" placeholder="(41) 99999-9999" />
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3 pt-0">
                        <button type="button" class="btn btn-light rounded-3 px-3 btn-sm" @onclick="() => exibirModalAluno = false">Cancelar</button>
                        <button type="button" class="btn btn-success rounded-3 px-4 btn-sm fw-semibold" @onclick="SalvarMatricula">Concluir Matrícula</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: FICHA DO ALUNO & EDIÇÃO EM COLUNA ÚNICA (SEM ESPAÇOS VAZIOS) -->
    @if (exibirModalDetalhes && alunoSelecionado != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header bg-primary text-white rounded-top-4">
                        <h5 class="modal-title fw-bold">📋 Ficha do Aluno</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalDetalhes = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <!-- Cabeçalho da Criança -->
                        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@alunoSelecionado.FotoUrl" class="rounded-circle shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                <div>
                                    <h4 class="fw-bold text-dark m-0">@alunoSelecionado.Nome</h4>
                                    <small class="text-muted">Nascimento: @alunoSelecionado.DataNascimento.ToShortDateString() • Senha Portal: <strong>@alunoSelecionado.DataNascimento.ToString("ddMMyyyy")</strong></small>
                                </div>
                            </div>
                            <button class="btn btn-outline-primary btn-sm rounded-3 px-3 fw-semibold" @onclick="() => modoEdicaoCrianca = !modoEdicaoCrianca">
                                @(modoEdicaoCrianca ? "🔒 Fechar Edição" : "✏️ Editar Criança")
                            </button>
                        </div>

                        <!-- Edição da Criança -->
                        @if (modoEdicaoCrianca)
                        {
                            <div class="card border border-primary rounded-4 p-3 mb-4 bg-white shadow-sm">
                                <h6 class="fw-bold text-primary mb-3">Editando Dados da Criança</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Nome da Criança</label>
                                        <input type="text" class="form-control rounded-3 form-control-sm" @bind="alunoSelecionado.Nome" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Data de Nascimento</label>
                                        <input type="date" class="form-control rounded-3 form-control-sm" @bind="alunoSelecionado.DataNascimento" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Turma</label>
                                        <select class="form-select rounded-3 form-select-sm" @bind="alunoSelecionado.TurmaId">
                                            @foreach (var t in turmasDisponiveis)
                                            {
                                                <option value="@t.Id">@t.Nome (@t.Turno)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold">Link da Foto (URL)</label>
                                        <input type="text" class="form-control rounded-3 form-control-sm" @bind="alunoSelecionado.FotoUrl" />
                                    </div>
                                    <div class="col-12 text-end mt-2">
                                        <button class="btn btn-sm btn-success rounded-3 px-4 fw-semibold" @onclick="SalvarAlteracoesCrianca">Salvar Criança</button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Lista de Pessoas (Titular e Autorizados) em Coluna Única -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark m-0">🛡️ Responsáveis e Pessoas Autorizadas</h6>
                            <small class="text-muted">Clique em "Editar" para alterar dados ou bloquear/liberar.</small>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var resp in responsaveisDoAluno)
                            {
                                <div class="card border rounded-4 p-3 @(resp.PodeRetirar ? "bg-white border-success border-2" : "bg-danger bg-opacity-10 border-danger border-2") shadow-none">
                                    
                                    <!-- Modo Visualização -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(resp.FotoUrl) ? "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80" : resp.FotoUrl)" class="rounded-circle shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" />
                                            <div>
                                                <h6 class="fw-bold text-dark m-0">@resp.Nome</h6>
                                                <small class="text-muted d-block">CPF: @resp.Cpf • Tel: @resp.Telefone • Parentesco: <strong>@resp.Parentesco</strong></small>
                                                <span class="badge @(resp.Principal ? "bg-primary" : "bg-secondary") rounded-pill mt-1" style="font-size: 0.65rem;">
                                                    @(resp.Principal ? "Titular do Contrato" : "Familiar Autorizado")
                                                </span>
                                            </div>
                                        </div>

                                        <div>
                                            @if (idResponsavelEmEdicao != resp.Id)
                                            {
                                                <button class="btn btn-sm btn-outline-primary rounded-3 px-3 py-1 fw-semibold" @onclick="() => AbrirEdicaoResponsavel(resp)">
                                                    ✏️ Editar & Status
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-secondary rounded-3 px-3 py-1 fw-semibold" @onclick="() => idResponsavelEmEdicao = 0">
                                                    🔒 Fechar
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <!-- Formulário de Edição Isolado (Abre embaixo do próprio card ocupando toda a largura) -->
                                    @if (idResponsavelEmEdicao == resp.Id && responsavelEmEdicao != null)
                                    {
                                        <div class="bg-light p-3 rounded-3 border mt-3 shadow-sm">
                                            <h6 class="fw-bold text-primary small mb-3">Editando: @resp.Nome</h6>
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Nome</label>
                                                    <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelEmEdicao.Nome" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">CPF</label>
                                                    <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelEmEdicao.Cpf" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Telefone</label>
                                                    <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelEmEdicao.Telefone" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Parentesco</label>
                                                    <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelEmEdicao.Parentesco" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label small fw-bold">Foto (URL)</label>
                                                    <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelEmEdicao.FotoUrl" />
                                                </div>
                                            </div>

                                            <!-- Status de Retirada dentro da edição -->
                                            <div class="mb-3 p-2 bg-white rounded-3 border d-flex justify-content-between align-items-center">
                                                <span class="small fw-bold text-dark">Status de Retirada:</span>
                                                <button type="button" class="btn btn-sm @(responsavelEmEdicao.PodeRetirar ? "btn-success" : "btn-danger") rounded-3 px-3 py-1 fw-semibold" @onclick="() => responsavelEmEdicao.PodeRetirar = !responsavelEmEdicao.PodeRetirar">
                                                    @(responsavelEmEdicao.PodeRetirar ? "🟢 Liberado" : "🔴 Bloqueado") (Clique para alternar)
                                                </button>
                                            </div>

                                            <div class="d-flex gap-2 justify-content-end">
                                                <button class="btn btn-sm btn-secondary rounded-3 px-3" @onclick="() => idResponsavelEmEdicao = 0">Cancelar</button>
                                                <button class="btn btn-sm btn-success rounded-3 px-4 fw-semibold" @onclick="SalvarResponsavel">Salvar Alterações</button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Status fixo na parte inferior (se não estiver editando) -->
                                    @if (idResponsavelEmEdicao != resp.Id)
                                    {
                                        <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                            <span class="small fw-bold @(resp.PodeRetirar ? "text-success" : "text-danger")">
                                                @(resp.PodeRetirar ? "🟢 Liberado para Retirada" : "🔴 Acesso Bloqueado")
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3 pt-0">
                        <button type="button" class="btn btn-secondary rounded-3 px-4 btn-sm" @onclick="() => exibirModalDetalhes = false">Fechar Ficha</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Escola? escola;
    private List<TurmaComAlunosDto> turmasComAlunos = new();
    private List<Turma> turmasDisponiveis = new();
    private int totalAlunosGeral = 0;
    
    private string? mensagemErro;
    private string? mensagemSucesso;

    private bool exibirModalTurma = false;
    private bool exibirModalAluno = false;
    private bool exibirModalDetalhes = false;
    private bool modoEdicaoCrianca = false;

    private Turma novaTurma = new();
    private Crianca novoAluno = new() { DataNascimento = DateTime.Today.AddYears(-3) };
    private Responsavel novoResponsavel = new();
    private int turmaSelecionadaId = 0;

    private Crianca? alunoSelecionado;
    private List<Responsavel> responsaveisDoAluno = new();
    
    private int idResponsavelEmEdicao = 0;
    private Responsavel? responsavelEmEdicao;

    public class AlunoComTitularDto
    {
        public Crianca Crianca { get; set; } = new();
        public Responsavel? Titular { get; set; }
    }

    public class TurmaComAlunosDto
    {
        public Turma Turma { get; set; } = new();
        public List<AlunoComTitularDto> AlunosComTitular { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosEscola();
    }

    private async Task CarregarDadosEscola()
    {
        try
        {
            escola = await Db.Escolas.FirstOrDefaultAsync(e => e.Id == Id);
            if (escola != null)
            {
                turmasDisponiveis = await Db.Turmas.Where(t => t.EscolaId == escola.Id).ToListAsync();
                turmasComAlunos = new List<TurmaComAlunosDto>();
                totalAlunosGeral = 0;

                foreach (var turma in turmasDisponiveis)
                {
                    var criancas = await Db.Criancas.Where(c => c.TurmaId == turma.Id).ToListAsync();
                    totalAlunosGeral += criancas.Count;

                    var listaDto = new List<AlunoComTitularDto>();
                    foreach (var c in criancas)
                    {
                        var titular = await Db.Responsaveis.FirstOrDefaultAsync(r => r.CriancaId == c.Id && r.Principal);
                        listaDto.Add(new AlunoComTitularDto { Crianca = c, Titular = titular });
                    }

                    turmasComAlunos.Add(new TurmaComAlunosDto
                    {
                        Turma = turma,
                        AlunosComTitular = listaDto
                    });
                }
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao carregar dados: {ex.Message}";
        }
    }

    private async Task SalvarTurma()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(novaTurma.Nome))
            {
                mensagemErro = "Informe o nome da turma.";
                return;
            }

            novaTurma.EscolaId = Id;
            Db.Turmas.Add(novaTurma);
            await Db.SaveChangesAsync();

            exibirModalTurma = false;
            novaTurma = new Turma();
            mensagemSucesso = "Turma cadastrada com sucesso!";
            await CarregarDadosEscola();
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao salvar turma: {ex.Message}";
        }
    }

    private async Task SalvarMatricula()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(novoAluno.Nome) || turmaSelecionadaId == 0)
            {
                mensagemErro = "Preencha o nome do aluno e selecione a turma.";
                return;
            }

            if (string.IsNullOrWhiteSpace(novoResponsavel.Nome) || string.IsNullOrWhiteSpace(novoResponsavel.Cpf))
            {
                mensagemErro = "Preencha os dados do responsável titular.";
                return;
            }

            novoAluno.TurmaId = turmaSelecionadaId;
            novoAluno.FotoUrl = "https://images.unsplash.com/photo-1543332164-6e82f355badc?w=150&auto=format&fit=crop&q=80";
            Db.Criancas.Add(novoAluno);
            await Db.SaveChangesAsync();

            novoResponsavel.CriancaId = novoAluno.Id;
            novoResponsavel.Principal = true;
            novoResponsavel.PodeRetirar = true;
            novoResponsavel.Parentesco = "Pai/Mãe (Titular do Contrato)";
            novoResponsavel.FotoUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80";
            Db.Responsaveis.Add(novoResponsavel);
            await Db.SaveChangesAsync();

            exibirModalAluno = false;
            novoAluno = new Crianca { DataNascimento = DateTime.Today.AddYears(-3) };
            novoResponsavel = new Responsavel();
            turmaSelecionadaId = 0;
            mensagemSucesso = "Aluno matriculado com sucesso!";
            await CarregarDadosEscola();
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao matricular: {ex.Message}";
        }
    }

    private async Task VerDetalhesAluno(int alunoId)
    {
        try
        {
            alunoSelecionado = await Db.Criancas.FirstOrDefaultAsync(c => c.Id == alunoId);
            responsaveisDoAluno = await Db.Responsaveis.Where(r => r.CriancaId == alunoId).ToListAsync();
            modoEdicaoCrianca = false;
            idResponsavelEmEdicao = 0;
            responsavelEmEdicao = null;
            exibirModalDetalhes = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao carregar detalhes do aluno: {ex.Message}";
        }
    }

    private async Task SalvarAlteracoesCrianca()
    {
        try
        {
            if (alunoSelecionado != null)
            {
                Db.Criancas.Update(alunoSelecionado);
                await Db.SaveChangesAsync();
                modoEdicaoCrianca = false;
                mensagemSucesso = "Dados da criança atualizados com sucesso!";
                await CarregarDadosEscola();
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao atualizar criança: {ex.Message}";
        }
    }

    private void AbrirEdicaoResponsavel(Responsavel resp)
    {
        idResponsavelEmEdicao = resp.Id;
        responsavelEmEdicao = resp;
    }

    private async Task SalvarResponsavel()
    {
        try
        {
            if (responsavelEmEdicao != null)
            {
                Db.Responsaveis.Update(responsavelEmEdicao);
                await Db.SaveChangesAsync();
                idResponsavelEmEdicao = 0;
                responsavelEmEdicao = null;
                mensagemSucesso = "Dados e status atualizados com sucesso!";
                await CarregarDadosEscola();
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao atualizar responsável: {ex.Message}";
        }
    }

    private async Task ExcluirEscola()
    {
        try
        {
            if (escola != null)
            {
                Db.Escolas.Remove(escola);
                await Db.SaveChangesAsync();
                Navigation.NavigateTo("/superadmin/escolas");
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao excluir: {ex.Message}";
        }
    }
}