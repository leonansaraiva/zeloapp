@page "/escola/detalhes/{EscolaId:int}"
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">🏫 Detalhes da Escola</h2>
            <p class="text-muted small m-0">Informações gerais e listagem de turmas e alunos.</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm rounded-3" @onclick="Voltar">← Voltar</button>
    </div>

    @if (escola == null)
    {
        <p class="text-muted">Carregando...</p>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h4 class="fw-bold text-dark">@escola.Nome</h4>
            <p class="text-muted small mb-1">CNPJ: @escola.Cnpj | Gestor(a): @escola.NomeGestor</p>
            <small class="text-muted">Contato: @escola.TelefoneGestor | @escola.EmailGestor</small>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-white p-3 px-4 border-bottom">
                <h5 class="fw-bold text-dark m-0">📚 Turmas e Alunos Matriculados</h5>
            </div>
            <div class="card-body p-4">
                @if (turmasList.Count == 0)
                {
                    <p class="text-muted text-center py-3">Nenhuma turma cadastrada.</p>
                }
                else
                {
                    <div class="accordion" id="accordionTurmas">
                        @foreach (var turma in turmasList)
                        {
                            var collapseId = $"turma_{turma.Id}";
                            <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                        📁 @turma.Nome (@(turma.Alunos?.Count ?? 0) alunos)
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordionTurmas">
                                    <div class="accordion-body bg-white p-3">
                                        @if (turma.Alunos == null || turma.Alunos.Count == 0)
                                        {
                                            <p class="text-muted small text-center">Nenhum aluno cadastrado nesta turma.</p>
                                        }
                                        else
                                        {
                                            <table class="table align-middle mb-0 small">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Aluno(a)</th>
                                                        <th>Responsável</th>
                                                        <th>Telefone</th>
                                                        <th>Mensalidade</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var aluno in turma.Alunos)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">@aluno.Nome</td>
                                                            <td>@aluno.NomeResponsavel</td>
                                                            <td>@aluno.TelefoneResponsavel</td>
                                                            <td><span class="text-success fw-bold">R$ @aluno.ValorMensalidade.ToString("N2")</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int EscolaId { get; set; }
    private Escola? escola;
    private List<Turma> turmasList = new();

    protected override async Task OnInitializedAsync()
    {
        escola = await Db.Escolas.FindAsync(EscolaId);
        turmasList = await Db.Turmas
            .Where(t => t.EscolaId == EscolaId)
            .Include(t => t.Alunos)
            .ToListAsync();
    }

    private void Voltar() => Navigation.NavigateTo("/superadmin/escolas");
}