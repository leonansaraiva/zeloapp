@page "/superadmin/escolas/{Id:int}"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Detalhes da Escola</PageTitle>

@if (escola == null)
{
    <div class="container mt-5 text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="container-fluid px-0 px-md-3 py-2">
        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <a href="/superadmin/escolas" class="btn btn-outline-secondary btn-sm mb-2">← Voltar para Lista</a>
                <h3 class="fw-bold m-0 fs-4">🏫 @escola.Nome</h3>
                <small class="text-muted">CNPJ: @escola.Cnpj</small>
            </div>
            <span class="badge bg-success fs-6">Ativa</span>
        </div>

        <!-- Abas com navegação fluid -->
        <ul class="nav nav-tabs mb-3 flex-nowrap overflow-auto">
            <li class="nav-item">
                <button class="nav-link text-nowrap @(abaAtiva == "turmas" ? "active fw-bold" : "")" @onclick='() => abaAtiva = "turmas"'>
                    👶 Turmas e Alunos (@turmas.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link text-nowrap @(abaAtiva == "gestores" ? "active fw-bold" : "")" @onclick='() => abaAtiva = "gestores"'>
                    👔 Equipe de Gestão (@gestores.Count)
                </button>
            </li>
        </ul>

        @if (abaAtiva == "turmas")
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0 fs-6">Salas de Aula e Alunos</h5>
                <button class="btn btn-primary btn-sm fw-semibold" @onclick="() => exibirModalTurma = true">+ Nova Turma</button>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-2 p-md-3">
                    @if (!turmas.Any())
                    {
                        <p class="text-muted text-center py-4 m-0">Nenhuma turma cadastrada ainda.</p>
                    }
                    else
                    {
                        @foreach (var turma in turmas)
                        {
                            <div class="mb-3 p-2 p-md-3 border rounded">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                                    <div>
                                        <h6 class="fw-bold text-primary m-0 fs-6">👶 @turma.Nome <span class="badge bg-light text-dark border ms-1">@turma.Turno</span></h6>
                                        <small class="text-muted">Educadora: <strong>@turma.EducadoraResponsavel</strong></small>
                                    </div>
                                    <button class="btn btn-outline-primary btn-sm fw-semibold" @onclick="() => AbrirModalCrianca(turma.Id)">+ Criança</button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 text-nowrap">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Foto</th>
                                                <th>Aluno(a)</th>
                                                <th>Nascimento</th>
                                                <th>Responsável Principal</th>
                                                <th>Autorizados</th>
                                                <th class="text-end">Ação</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!turma.Criancas.Any())
                                            {
                                                <tr>
                                                    <td colspan="6" class="text-center text-muted py-3">Nenhum aluno nesta turma.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var crianca in turma.Criancas)
                                                {
                                                    var respPrincipal = crianca.Responsaveis.FirstOrDefault(r => r.Principal) ?? crianca.Responsaveis.FirstOrDefault();
                                                    <tr>
                                                        <td>
                                                            <img src="@crianca.FotoUrl" class="rounded-circle border" width="38" height="38" style="object-fit: cover;" />
                                                        </td>
                                                        <td class="fw-bold">@crianca.Nome</td>
                                                        <td>@crianca.DataNascimento.ToShortDateString()</td>
                                                        <td>
                                                            @if (respPrincipal != null)
                                                            {
                                                                <span>@respPrincipal.Nome (@respPrincipal.Parentesco)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">Convite Enviado</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-info">@crianca.Responsaveis.Count(r => r.PodeRetirar) autorizados</span>
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => criancaSelecionada = crianca">
                                                                🔍 Responsáveis
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (abaAtiva == "gestores")
        {
            <div class="card border-0 shadow-sm p-2 p-md-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0 fs-6">👔 Equipe de Gestão e Professores</h5>
                    <button class="btn btn-primary btn-sm fw-semibold" @onclick="() => exibirModalGestor = true">+ Convidar Membro</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle text-nowrap">
                        <thead class="table-light">
                            <tr>
                                <th>Foto</th>
                                <th>Nome</th>
                                <th>Função</th>
                                <th>E-mail</th>
                                <th>Telefone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gestor in gestores)
                            {
                                <tr>
                                    <td>
                                        <img src="@gestor.FotoUrl" class="rounded-circle border" width="38" height="38" style="object-fit: cover;" />
                                    </td>
                                    <td class="fw-bold">@gestor.Nome</td>
                                    <td><span class="badge bg-primary">@gestor.Cargo</span></td>
                                    <td>@gestor.Email</td>
                                    <td>@gestor.Telefone</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- MODAL DE CADASTRO DE TURMA -->
    @if (exibirModalTurma)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold fs-6">➕ Cadastrar Nova Turma</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalTurma = false"></button>
                    </div>
                    <EditForm Model="novaTurma" OnValidSubmit="SalvarTurma">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label font-semibold">Nome da Turma</label>
                                <InputText class="form-control" @bind-Value="novaTurma.Nome" placeholder="Ex: Berçário II" />
                                <ValidationMessage For="@(() => novaTurma.Nome)" class="text-danger small" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-semibold">Turno</label>
                                <InputSelect class="form-select" @bind-Value="novaTurma.Turno">
                                    <option value="Integral">Integral</option>
                                    <option value="Manhã">Manhã</option>
                                    <option value="Tarde">Tarde</option>
                                </InputSelect>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-semibold">Educadora Responsável</label>
                                <InputText class="form-control" @bind-Value="novaTurma.EducadoraResponsavel" placeholder="Profª Nome" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="() => exibirModalTurma = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold">Salvar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- MODAL CADASTRO CRIANÇA -->
    @if (exibirModalCrianca)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold fs-6">👶 Cadastrar Criança e Enviar Convite</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalCrianca = false"></button>
                    </div>
                    <EditForm Model="novaCrianca" OnValidSubmit="SalvarCrianca">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label font-semibold">Nome Completo da Criança</label>
                                <InputText class="form-control" @bind-Value="novaCrianca.Nome" placeholder="Ex: Gabriel Martins" />
                                <ValidationMessage For="@(() => novaCrianca.Nome)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label font-semibold">Data de Nascimento</label>
                                <InputDate class="form-control" @bind-Value="novaCrianca.DataNascimento" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label font-semibold">E-mail do Responsável Principal</label>
                                <InputText class="form-control" @bind-Value="novaCrianca.EmailResponsavelConvidado" placeholder="mae@gmail.com" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="() => exibirModalCrianca = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold">Cadastrar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- MODAL GESTOR -->
    @if (exibirModalGestor)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold fs-6">📧 Convidar Membro</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalGestor = false"></button>
                    </div>
                    <EditForm Model="novoGestor" OnValidSubmit="SalvarGestor">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label font-semibold">Nome Completo</label>
                                <InputText class="form-control" @bind-Value="novoGestor.Nome" placeholder="Ex: Juliana Costa" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-semibold">E-mail de Convite</label>
                                <InputText class="form-control" @bind-Value="novoGestor.Email" placeholder="professora@escola.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-semibold">Cargo / Função</label>
                                <InputSelect class="form-select" @bind-Value="novoGestor.Cargo">
                                    <option value="Professora / Educadora">Professora / Educadora</option>
                                    <option value="Coordenadora Pedagógica">Coordenadora Pedagógica</option>
                                    <option value="Diretora">Diretora</option>
                                    <option value="Secretaria">Secretaria</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="() => exibirModalGestor = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold">Enviar Convite</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- MODAL VER RESPONSÁVEIS -->
    @if (criancaSelecionada != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold fs-6">👨‍👩‍👧 Responsáveis de: @criancaSelecionada.Nome</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => criancaSelecionada = null"></button>
                    </div>
                    <div class="modal-body p-2 p-md-3">
                        <div class="list-group">
                            @foreach (var resp in criancaSelecionada.Responsaveis)
                            {
                                <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between p-2 p-md-3 gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@resp.FotoUrl" class="rounded-circle border" width="45" height="45" style="object-fit: cover;" />
                                        <div>
                                            <h6 class="mb-0 fw-bold fs-6">@resp.Nome @(resp.Principal ? "⭐" : "")</h6>
                                            <p class="mb-0 text-muted small">@resp.Parentesco • CPF: @resp.Cpf</p>
                                        </div>
                                    </div>
                                    <div>
                                        @if (resp.PodeRetirar)
                                        {
                                            <span class="badge bg-success">✅ Pode Retirar</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">🚫 Bloqueado</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary btn-sm" @onclick="() => criancaSelecionada = null">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Escola? escola;
    private List<Turma> turmas = new();
    private List<GestorEscola> gestores = new();
    private string abaAtiva = "turmas";

    private Turma novaTurma = new();
    private Crianca novaCrianca = new();
    private GestorEscola novoGestor = new();

    private bool exibirModalTurma = false;
    private bool exibirModalCrianca = false;
    private bool exibirModalGestor = false;

    private int turmaIdSelecionada = 0;
    private Crianca? criancaSelecionada;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        escola = await Db.Escolas.FirstOrDefaultAsync(e => e.Id == Id);
        if (escola != null)
        {
            gestores = await Db.Gestores.Where(g => g.EscolaId == Id).ToListAsync();
            turmas = await Db.Turmas
                .Include(t => t.Criancas)
                .ThenInclude(c => c.Responsaveis)
                .Where(t => t.EscolaId == Id)
                .ToListAsync();
        }
    }

    private async Task SalvarTurma()
    {
        novaTurma.EscolaId = Id;
        Db.Turmas.Add(novaTurma);
        await Db.SaveChangesAsync();
        exibirModalTurma = false;
        novaTurma = new Turma();
        await CarregarDados();
    }

    private void AbrirModalCrianca(int turmaId)
    {
        turmaIdSelecionada = turmaId;
        novaCrianca = new Crianca { TurmaId = turmaId, FotoUrl = "https://images.unsplash.com/photo-1543332164-6e82f355badc?w=150&auto=format&fit=crop&q=80" };
        exibirModalCrianca = true;
    }

    private async Task SalvarCrianca()
    {
        Db.Criancas.Add(novaCrianca);
        await Db.SaveChangesAsync();
        exibirModalCrianca = false;
        await CarregarDados();
    }

    private async Task SalvarGestor()
    {
        novoGestor.EscolaId = Id;
        novoGestor.FotoUrl = "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80";
        Db.Gestores.Add(novoGestor);
        await Db.SaveChangesAsync();
        exibirModalGestor = false;
        novoGestor = new GestorEscola();
        await CarregarDados();
    }
}