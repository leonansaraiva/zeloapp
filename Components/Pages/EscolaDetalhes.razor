@page "/superadmin/escolas/{Id:int}"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Detalhes da Escola</PageTitle>

@if (escola == null)
{
    <div class="container text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="container py-2 px-3">
        <!-- Header -->
        <div class="mb-3">
            <a href="/superadmin/escolas" class="btn btn-outline-secondary btn-sm mb-2">← Voltar</a>
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0 text-dark">🏫 @escola.Nome</h5>
                <span class="badge bg-success">Ativa</span>
            </div>
            <small class="text-muted">CNPJ: @escola.Cnpj</small>
        </div>

        <!-- Abas -->
        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-sm flex-fill @(abaAtiva == "turmas" ? "btn-primary" : "btn-light border")" @onclick='() => abaAtiva = "turmas"'>
                👶 Turmas (@turmas.Count)
            </button>
            <button class="btn btn-sm flex-fill @(abaAtiva == "gestores" ? "btn-primary" : "btn-light border")" @onclick='() => abaAtiva = "gestores"'>
                👔 Equipe (@gestores.Count)
            </button>
        </div>

        @if (abaAtiva == "turmas")
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0">Turmas e Alunos</h6>
                <button class="btn btn-primary btn-sm fw-semibold" @onclick="() => exibirModalTurma = true">+ Turma</button>
            </div>

            @foreach (var turma in turmas)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                        <div>
                            <strong class="text-primary fs-6">👶 @turma.Nome</strong>
                            <small class="text-muted ms-1">(@turma.Turno)</small>
                        </div>
                        <button class="btn btn-outline-primary btn-sm px-2 py-0" @onclick="() => AbrirModalCrianca(turma.Id)">+ Criança</button>
                    </div>
                    <div class="card-body p-2">
                        @if (!turma.Criancas.Any())
                        {
                            <small class="text-muted d-block text-center py-2">Nenhum aluno cadastrado nesta turma.</small>
                        }
                        else
                        {
                            @foreach (var crianca in turma.Criancas)
                            {
                                var respPrincipal = crianca.Responsaveis.FirstOrDefault(r => r.Principal) ?? crianca.Responsaveis.FirstOrDefault();
                                <div class="mobile-card d-flex align-items-center justify-content-between p-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@crianca.FotoUrl" class="rounded-circle border" width="45" height="45" style="object-fit: cover;" />
                                        <div>
                                            <strong class="d-block text-dark small">@crianca.Nome</strong>
                                            @if (respPrincipal != null)
                                            {
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">Resp: @respPrincipal.Nome (@respPrincipal.Parentesco)</small>
                                            }
                                            else
                                            {
                                                <small class="text-warning fw-bold d-block" style="font-size: 0.75rem;">⚠️ Sem responsável</small>
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-light border px-2" @onclick="() => criancaSelecionada = crianca">
                                        🔍 Ver
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }

        @if (abaAtiva == "gestores")
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0">Equipe de Gestão</h6>
                <button class="btn btn-primary btn-sm fw-semibold" @onclick="() => exibirModalGestor = true">+ Convidar</button>
            </div>

            @foreach (var gestor in gestores)
            {
                <div class="mobile-card d-flex align-items-center gap-3 p-3 mb-2">
                    <img src="@gestor.FotoUrl" class="rounded-circle border" width="48" height="48" style="object-fit: cover;" />
                    <div>
                        <strong class="d-block text-dark">@gestor.Nome</strong>
                        <span class="badge bg-primary my-1">@gestor.Cargo</span>
                        <small class="text-muted d-block">✉️ @gestor.Email</small>
                    </div>
                </div>
            }
        }
    </div>

    <!-- MODAL RESPONSÁVEIS / CONVIDAR RESPONSÁVEL -->
    @if (criancaSelecionada != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white py-2">
                        <h6 class="modal-title fw-bold">👨‍👩‍👧 Responsáveis: @criancaSelecionada.Nome</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => criancaSelecionada = null"></button>
                    </div>
                    <div class="modal-body p-3">
                        @if (!criancaSelecionada.Responsaveis.Any())
                        {
                            <div class="alert alert-warning p-2 small mb-3">
                                ⚠️ <strong>Atenção:</strong> NENHUM responsável vinculado ainda. Envie o convite inicial abaixo.
                            </div>
                        }
                        else
                        {
                            @foreach (var resp in criancaSelecionada.Responsaveis)
                            {
                                <div class="mobile-card d-flex align-items-center justify-content-between p-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@resp.FotoUrl" class="rounded-circle border" width="40" height="40" style="object-fit: cover;" />
                                        <div>
                                            <strong class="d-block small text-dark">@resp.Nome @(resp.Principal ? "⭐" : "")</strong>
                                            <small class="text-muted d-block" style="font-size: 0.7rem;">@resp.Parentesco • CPF: @resp.Cpf</small>
                                        </div>
                                    </div>
                                    <span class="badge @(resp.PodeRetirar ? "bg-success" : "bg-danger")">
                                        @(resp.PodeRetirar ? "Pode Retirar" : "Bloqueado")
                                    </span>
                                </div>
                            }
                        }

                        <hr />
                        <h6 class="fw-bold small text-dark mb-2">📧 Convidar Novo Responsável por E-mail</h6>
                        <EditForm Model="novoRespConvite" OnValidSubmit="ConvidarResponsavel">
                            <div class="mb-2">
                                <label class="form-label small">Nome do Responsável</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novoRespConvite.Nome" placeholder="Ex: Fernanda Silva" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">E-mail do Responsável</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novoRespConvite.Email" placeholder="mae@gmail.com" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Parentesco</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="novoRespConvite.Parentesco">
                                    <option value="Mãe">Mãe</option>
                                    <option value="Pai">Pai</option>
                                    <option value="Avó/Avô">Avó / Avô</option>
                                    <option value="Tio/Tia">Tio / Tia</option>
                                </InputSelect>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold mt-2">
                                Enviar Convite de Acesso
                            </button>
                        </EditForm>
                    </div>
                    <div class="modal-footer p-2">
                        <button class="btn btn-secondary btn-sm" @onclick="() => criancaSelecionada = null">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL TURMA E CRIANÇA -->
    @if (exibirModalTurma)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white py-2">
                        <h6 class="modal-title fw-bold">➕ Nova Turma</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalTurma = false"></button>
                    </div>
                    <EditForm Model="novaTurma" OnValidSubmit="SalvarTurma">
                        <DataAnnotationsValidator />
                        <div class="modal-body p-3">
                            <div class="mb-2">
                                <label class="form-label small">Nome da Turma</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novaTurma.Nome" placeholder="Ex: Berçário II" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Turno</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="novaTurma.Turno">
                                    <option value="Integral">Integral</option>
                                    <option value="Manhã">Manhã</option>
                                    <option value="Tarde">Tarde</option>
                                </InputSelect>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Educadora Responsável</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novaTurma.EducadoraResponsavel" placeholder="Profª Nome" />
                            </div>
                        </div>
                        <div class="modal-footer p-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => exibirModalTurma = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-sm">Salvar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (exibirModalCrianca)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white py-2">
                        <h6 class="modal-title fw-bold">👶 Cadastrar Criança</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalCrianca = false"></button>
                    </div>
                    <EditForm Model="novaCrianca" OnValidSubmit="SalvarCrianca">
                        <DataAnnotationsValidator />
                        <div class="modal-body p-3">
                            <div class="mb-2">
                                <label class="form-label small">Nome da Criança</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novaCrianca.Nome" placeholder="Gabriel Silva" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Data de Nascimento</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="novaCrianca.DataNascimento" />
                            </div>
                        </div>
                        <div class="modal-footer p-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => exibirModalCrianca = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-sm">Cadastrar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (exibirModalGestor)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white py-2">
                        <h6 class="modal-title fw-bold">📧 Convidar Membro</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalGestor = false"></button>
                    </div>
                    <EditForm Model="novoGestor" OnValidSubmit="SalvarGestor">
                        <DataAnnotationsValidator />
                        <div class="modal-body p-3">
                            <div class="mb-2">
                                <label class="form-label small">Nome Completo</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novoGestor.Nome" placeholder="Juliana Costa" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">E-mail</label>
                                <InputText class="form-control form-control-sm" @bind-Value="novoGestor.Email" placeholder="professora@escola.com" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Cargo</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="novoGestor.Cargo">
                                    <option value="Professora / Educadora">Professora / Educadora</option>
                                    <option value="Coordenadora Pedagógica">Coordenadora Pedagógica</option>
                                    <option value="Diretora">Diretora</option>
                                </InputSelect>
                            </div>
                        </div>
                        <div class="modal-footer p-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => exibirModalGestor = false">Cancelar</button>
                            <button type="submit" class="btn btn-primary btn-sm">Enviar Convite</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Escola? escola;
    private List<Turma> turmas = new();
    private List<GestorEscola> gestores = new();
    private string abaAtiva = "turmas";

    private Turma novaTurma = new();
    private Crianca novaCrianca = new();
    private GestorEscola novoGestor = new();
    private ConviteModel novoRespConvite = new();

    private bool exibirModalTurma = false;
    private bool exibirModalCrianca = false;
    private bool exibirModalGestor = false;

    private int turmaIdSelecionada = 0;
    private Crianca? criancaSelecionada;

    public class ConviteModel
    {
        public string Nome { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Parentesco { get; set; } = "Mãe";
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        escola = await Db.Escolas.FirstOrDefaultAsync(e => e.Id == Id);
        if (escola != null)
        {
            gestores = await Db.Gestores.Where(g => g.EscolaId == Id).ToListAsync();
            turmas = await Db.Turmas
                .Include(t => t.Criancas)
                .ThenInclude(c => c.Responsaveis)
                .Where(t => t.EscolaId == Id)
                .ToListAsync();
        }
    }

    private async Task SalvarTurma()
    {
        novaTurma.EscolaId = Id;
        Db.Turmas.Add(novaTurma);
        await Db.SaveChangesAsync();
        exibirModalTurma = false;
        novaTurma = new Turma();
        await CarregarDados();
    }

    private void AbrirModalCrianca(int turmaId)
    {
        turmaIdSelecionada = turmaId;
        novaCrianca = new Crianca { TurmaId = turmaId, FotoUrl = "https://images.unsplash.com/photo-1543332164-6e82f355badc?w=150&auto=format&fit=crop&q=80" };
        exibirModalCrianca = true;
    }

    private async Task SalvarCrianca()
    {
        Db.Criancas.Add(novaCrianca);
        await Db.SaveChangesAsync();
        exibirModalCrianca = false;
        await CarregarDados();
    }

    private async Task SalvarGestor()
    {
        novoGestor.EscolaId = Id;
        novoGestor.FotoUrl = "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80";
        Db.Gestores.Add(novoGestor);
        await Db.SaveChangesAsync();
        exibirModalGestor = false;
        novoGestor = new GestorEscola();
        await CarregarDados();
    }

    private async Task ConvidarResponsavel()
    {
        if (criancaSelecionada != null)
        {
            var resp = new Responsavel
            {
                CriancaId = criancaSelecionada.Id,
                Nome = string.IsNullOrEmpty(novoRespConvite.Nome) ? "Responsável Convidado" : novoRespConvite.Nome,
                Cpf = "Aguardando Cadastro",
                Parentesco = novoRespConvite.Parentesco,
                PodeRetirar = true,
                Principal = true,
                FotoUrl = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80"
            };

            Db.Responsaveis.Add(resp);
            await Db.SaveChangesAsync();
            novoRespConvite = new ConviteModel();
            await CarregarDados();
            criancaSelecionada = await Db.Criancas.Include(c => c.Responsaveis).FirstOrDefaultAsync(c => c.Id == criancaSelecionada.Id);
        }
    }
}