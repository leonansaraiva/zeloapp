@page "/"
@using ZeloApp.Services
@inject NavigationManager Navigation
@inject AuthStateService Auth

<div class="container d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="text-center">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <h5 class="fw-bold text-dark">Carregando o ZeloApp...</h5>
        <p class="text-muted small">Aguarde um instante.</p>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Verifica se o usuário já possui sessão ativa
        if (Auth.EstaAutenticado)
        {
            if (Auth.TipoUsuario == "SuperAdmin")
            {
                Navigation.NavigateTo("/superadmin/escolas", forceLoad: true);
            }
            else if (Auth.EscolaId > 0)
            {
                Navigation.NavigateTo($"/escola/gerenciar/{Auth.EscolaId}", forceLoad: true);
            }
            else
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        else
        {
            // Se não estiver logado, redireciona para o login
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}