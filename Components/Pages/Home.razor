@page "/"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Painel do Sistema</PageTitle>

<div class="container py-2 px-3">
    <!-- Cabeçalho -->
    <div class="p-3 mb-3 bg-primary text-white rounded-3 shadow-sm">
        <h3 class="fw-bold m-0 fs-5">🛡️ Plataforma Zelo</h3>
        <p class="small m-0 opacity-75">Gestão escolar e segurança na entrega de alunos.</p>
    </div>

    <!-- Cards de Métricas e Status -->
    <div class="row g-2 mb-3">
        <div class="col-6">
            <div class="card border-0 shadow-sm border-start border-primary border-4 p-2">
                <small class="text-muted fw-semibold" style="font-size: 0.7rem;">ESCOLAS</small>
                <h3 class="fw-bold text-primary m-0 fs-4">@totalEscolas</h3>
                <small class="text-muted" style="font-size: 0.7rem;">Instituições</small>
            </div>
        </div>

        <div class="col-6">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-2">
                <small class="text-muted fw-semibold" style="font-size: 0.7rem;">STATUS</small>
                <h3 class="fw-bold text-success m-0 fs-4">🟢 Online</h3>
                <small class="text-muted" style="font-size: 0.7rem;">Operacional</small>
            </div>
        </div>
    </div>

    <!-- Lista de Escolas Recentes em CARDS (Sem Tabela / Sem Scroll Horizontal) -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="fw-bold m-0 text-dark">🏫 Escolas Cadastradas</h6>
        <a href="/superadmin/escolas" class="btn btn-primary btn-sm px-2 py-1 fs-7">+ Nova Escola</a>
    </div>

    @if (escolasRecentes == null || !escolasRecentes.Any())
    {
        <div class="card border-0 shadow-sm p-3 text-center text-muted small">
            Nenhuma escola cadastrada no momento.
        </div>
    }
    else
    {
        @foreach (var escola in escolasRecentes)
        {
            <div class="mobile-card mb-2 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <strong class="d-block text-dark fs-6">@escola.Nome</strong>
                        <small class="text-muted d-block">CNPJ: @escola.Cnpj</small>
                    </div>
                    <span class="badge bg-success">Ativa</span>
                </div>
                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                    <small class="text-muted">👤 @escola.NomeGestor</small>
                    <a href="/superadmin/escolas/@escola.Id" class="btn btn-sm btn-outline-primary py-1 px-3 fw-semibold">
                        Acessar Escola →
                    </a>
                </div>
            </div>
        }
    }
</div>

@code {
    private int totalEscolas = 0;
    private List<Escola> escolasRecentes = new();

    protected override async Task OnInitializedAsync()
    {
        totalEscolas = await Db.Escolas.CountAsync();
        escolasRecentes = await Db.Escolas.OrderByDescending(e => e.Id).Take(5).ToListAsync();
    }
}