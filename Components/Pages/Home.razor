@page "/"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Painel do Sistema</PageTitle>

<div class="container-fluid px-0 px-md-3 py-2">
    <!-- Cabeçalho -->
    <div class="p-3 p-md-4 mb-4 bg-primary text-white rounded-3 shadow-sm">
        <h2 class="display-6 fw-bold mb-1">🛡️ Plataforma Zelo</h2>
        <p class="fs-6 m-0 opacity-75">Sistema integrado de gestão escolar e segurança de retirada.</p>
    </div>

    <!-- Cards de Módulos (1 Coluna no Mobile / 3 no Desktop) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-primary border-4 p-2">
                <div class="card-body p-3">
                    <small class="text-muted fw-semibold">ESCOLAS CADASTRADAS</small>
                    <h2 class="fw-bold text-primary my-1">@totalEscolas</h2>
                    <small class="text-muted">Instituições ativas na plataforma.</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-4 p-2">
                <div class="card-body p-3">
                    <small class="text-muted fw-semibold">STATUS DA PLATAFORMA</small>
                    <h2 class="fw-bold text-success my-1">🟢 Online</h2>
                    <small class="text-muted">Servidores e banco operacionais.</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100 border-start border-warning border-4 p-2 d-flex flex-column justify-content-between">
                <div class="card-body p-3">
                    <small class="text-muted fw-semibold">MÓDULO SUPER ADMIN</small>
                    <h5 class="fw-bold mb-1">Gestão de Escolas</h5>
                    <a href="/superadmin/escolas" class="btn btn-outline-primary btn-sm w-100 fw-semibold mt-2">
                        Gerenciar Escolas →
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela Resumida de Escolas com Scroll Horizontal para Mobile -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="m-0 fw-bold text-dark fs-6">🏫 Escolas Cadastradas Recentemente</h5>
            <a href="/superadmin/escolas" class="btn btn-primary btn-sm px-3">+ Nova Escola</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Escola</th>
                            <th>CNPJ</th>
                            <th>Gestor(a)</th>
                            <th>Contato</th>
                            <th class="text-end pe-3">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (escolasRecentes == null || !escolasRecentes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Nenhuma escola cadastrada.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var escola in escolasRecentes)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">
                                        <a href="/superadmin/escolas/@escola.Id" class="text-decoration-none text-primary">@escola.Nome</a>
                                    </td>
                                    <td>@escola.Cnpj</td>
                                    <td>@escola.NomeGestor</td>
                                    <td>@escola.EmailGestor</td>
                                    <td class="text-end pe-3">
                                        <a href="/superadmin/escolas/@escola.Id" class="btn btn-sm btn-light border">Ver Detalhes</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalEscolas = 0;
    private List<Escola> escolasRecentes = new();

    protected override async Task OnInitializedAsync()
    {
        totalEscolas = await Db.Escolas.CountAsync();
        escolasRecentes = await Db.Escolas.OrderByDescending(e => e.Id).Take(5).ToListAsync();
    }
}