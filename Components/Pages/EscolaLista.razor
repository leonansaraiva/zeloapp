@page "/superadmin/escolas"
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject AuthStateService Auth
@rendermode InteractiveServer

<PageTitle>Zelo - Painel Super Admin (SaaS)</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge bg-primary-subtle text-primary fw-bold mb-1 px-3 py-1 rounded-pill">Painel Administrativo Geral</span>
            <h2 class="fw-bold text-dark m-0 fs-3">Gestão de Escolas & SaaS</h2>
            <p class="text-muted small m-0">Acompanhamento financeiro anual e aquisição de clientes.</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm btn-sm" @onclick="AbrirModalNovaEscola">
                + Nova Escola (Cliente)
            </button>
        </div>
    </div>

    <!-- MÉTRICAS -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-success border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Receita Efetiva (Pago)</small>
                <span class="fs-6 fs-md-4 fw-bold text-success">R$ @receitaEfetivaMes.ToString("N2")</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-primary border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Previsão de Receita</small>
                <span class="fs-6 fs-md-4 fw-bold text-primary">R$ @receitaPrevisaoMes.ToString("N2")</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-danger border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Custo Fixo (Servidor)</small>
                <span class="fs-6 fs-md-4 fw-bold text-danger">R$ @custoServidor.ToString("N2")</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-warning border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Inadimplentes (Mês)</small>
                <span class="fs-6 fs-md-4 fw-bold text-warning">@escolasInadimplentes</span>
            </div>
        </div>
    </div>

    <!-- GRÁFICO DE BARRAS VERTICAIS (FINANCEIRO ANUAL) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 mb-4">
        <h5 class="fw-bold text-dark mb-1 fs-6">📊 Demonstrativo Financeiro Anual</h5>
        <p class="text-muted small mb-4">Evolução do faturamento mês a mês</p>
        
        <div class="d-flex align-items-end justify-content-between gap-1 gap-md-2 border-bottom pb-2" style="height: 180px;">
            @foreach (var m in demonstrativoAnual)
            {
                var alturaPct = maxValorGrafico > 0 ? (int)((m.Receita / maxValorGrafico) * 130) : 10;
                <div class="d-flex flex-column align-items-center flex-grow-1">
                    <span class="small fw-bold text-primary mb-1" style="font-size: 0.55rem;">R$ @m.Receita.ToString("N0")</span>
                    <div class="w-100 bg-primary-subtle rounded-top d-flex align-items-end justify-content-center" style="height: 130px; max-width: 30px;">
                        <div class="w-100 bg-primary rounded-top" style="height: @Math.Max(alturaPct, 5)px; transition: height 0.3s;"></div>
                    </div>
                </div>
            }
        </div>
        <div class="d-flex justify-content-between text-muted small mt-2 px-1">
            @foreach (var m in demonstrativoAnual)
            {
                <span style="font-size: 0.65rem; width: 30px; text-align: center;">@m.NomeMes.Substring(0, 3)</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-4 p-3 shadow-sm mb-4">✅ @mensagemSucesso</div>
    }

    <!-- TABELA / CARDS DE ESCOLAS (SEM SCROLL HORIZONTAL) -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white p-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark m-0 fs-6">🏫 Escolas Clientes da Plataforma</h5>
            <span class="badge bg-secondary rounded-pill px-3 py-1">@listaEscolas.Count unidades</span>
        </div>

        <!-- VISÃO DE TABELA PARA TELAS GRANDES (d-none d-md-block) -->
        <div class="table-responsive d-none d-md-block">
            <table class="table align-middle mb-0 small">
                <thead class="table-light text-secondary uppercase">
                    <tr>
                        <th class="ps-3">Escola / CNPJ</th>
                        <th>Gestor(a) & Contato</th>
                        <th>Alunos</th>
                        <th>Assinatura</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var escola in listaEscolas)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@escola.Nome</div>
                                <small class="text-muted">@escola.Cnpj</small>
                            </td>
                            <td>
                                <div class="text-dark">@escola.NomeGestor</div>
                                <small class="text-muted">@escola.TelefoneGestor</small>
                            </td>
                            <td><span class="badge bg-light text-dark border px-2 py-1">@(escolasAlunosCount.ContainsKey(escola.Id) ? escolasAlunosCount[escola.Id] : 0)</span></td>
                            <td><span class="fw-bold text-success">R$ @escola.ValorMensalidadePlataforma.ToString("N2")</span></td>
                            <td>
                                @if (escola.MensalidadeAtualPaga)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-0.5 rounded-pill">🟢 Pago</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-0.5 rounded-pill">🔴 Pendente</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1" style="font-size: 0.75rem;" @onclick="() => GerenciarEscola(escola.Id)">
                                    Gerenciar →
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- VISÃO EM CARDS PARA CELULAR (d-block d-md-none) - ZERO SCROLL HORIZONTAL -->
        <div class="d-block d-md-none p-3">
            <div class="d-flex flex-column gap-3">
                @foreach (var escola in listaEscolas)
                {
                    <div class="card border shadow-none rounded-4 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold text-dark m-0">@escola.Nome</h6>
                                <small class="text-muted" style="font-size: 0.7rem;">CNPJ: @escola.Cnpj</small>
                            </div>
                            <div>
                                @if (escola.MensalidadeAtualPaga)
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-0.5 rounded-pill" style="font-size: 0.65rem;">🟢 Pago</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-0.5 rounded-pill" style="font-size: 0.65rem;">🔴 Pendente</span>
                                }
                            </div>
                        </div>
                        <div class="small text-muted mb-3">
                            <div>Gestor(a): <strong class="text-dark">@escola.NomeGestor</strong></div>
                            <div>Alunos: <strong class="text-dark">@(escolasAlunosCount.ContainsKey(escola.Id) ? escolasAlunosCount[escola.Id] : 0)</strong> | Valor: <strong class="text-success">R$ @escola.ValorMensalidadePlataforma.ToString("N2")</strong></div>
                        </div>
                        <button class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm" style="font-size: 0.8rem;" @onclick="() => GerenciarEscola(escola.Id)">
                            Gerenciar Unidade →
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- MODAL -->
@if (exibirModalNovaEscola)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered mx-2 mx-md-auto">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold fs-6">🏫 Nova Escola / Creche</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalNovaEscola = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nome da Creche</label>
                        <input type="text" class="form-control rounded-pill" @bind="novaEscola.Nome" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">CNPJ</label>
                            <input type="text" class="form-control rounded-pill" @bind="novaEscola.Cnpj" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Gestor(a)</label>
                            <input type="text" class="form-control rounded-pill" @bind="novaEscola.NomeGestor" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Telefone</label>
                            <input type="text" class="form-control rounded-pill" @bind="novaEscola.TelefoneGestor" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Login Admin</label>
                            <input type="text" class="form-control rounded-pill" @bind="novaEscola.LoginAdmin" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => exibirModalNovaEscola = false">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold" @onclick="SalvarNovaEscola">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Escola> listaEscolas = new();
    private Dictionary<int, int> escolasAlunosCount = new();
    private List<MesFinanceiro> demonstrativoAnual = new();
    private decimal receitaEfetivaMes = 0;
    private decimal receitaPrevisaoMes = 0;
    private decimal custoServidor = 150.00m;
    private int escolasInadimplentes = 0;
    private decimal maxValorGrafico = 1000m;
    private bool exibirModalNovaEscola = false;
    private Escola novaEscola = new() { ValorMensalidadePlataforma = 450.00m, MensalidadeAtualPaga = true };
    private string mensagemSucesso = string.Empty;

    public class MesFinanceiro
    {
        public string NomeMes { get; set; } = string.Empty;
        public decimal Receita { get; set; }
    }

    protected override async Task OnInitializedAsync() => await CarregarDadosSuperAdmin();

    private async Task CarregarDadosSuperAdmin()
    {
        listaEscolas = await Db.Escolas.ToListAsync();
        var todasAsTurmas = await Db.Turmas.Include(t => t.Alunos).ToListAsync();
        receitaPrevisaoMes = 0; receitaEfetivaMes = 0; escolasInadimplentes = 0; escolasAlunosCount.Clear();

        foreach (var escola in listaEscolas)
        {
            receitaPrevisaoMes += escola.ValorMensalidadePlataforma;
            if (escola.MensalidadeAtualPaga) receitaEfetivaMes += escola.ValorMensalidadePlataforma;
            else escolasInadimplentes++;
            escolasAlunosCount[escola.Id] = todasAsTurmas.Where(t => t.EscolaId == escola.Id).Sum(t => t.Alunos?.Count ?? 0);
        }

        string[] meses = { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
        demonstrativoAnual.Clear(); maxValorGrafico = 1000m;
        int baseUnidades = Math.Max(1, listaEscolas.Count);

        for (int i = 0; i < meses.Length; i++)
        {
            decimal recMes = i <= DateTime.Now.Month - 1 ? (baseUnidades * 450.00m) : 0;
            if (recMes > maxValorGrafico) maxValorGrafico = recMes;
            demonstrativoAnual.Add(new MesFinanceiro { NomeMes = meses[i], Receita = recMes });
        }
    }

    private void AbrirModalNovaEscola() => exibirModalNovaEscola = true;
    private async Task SalvarNovaEscola()
    {
        Db.Escolas.Add(novaEscola); await Db.SaveChangesAsync();
        exibirModalNovaEscola = false; mensagemSucesso = "Escola cadastrada!"; await CarregarDadosSuperAdmin();
    }
    private void GerenciarEscola(int id) => Navigation.NavigateTo($"/superadmin/escola/gerenciar/{id}");
}