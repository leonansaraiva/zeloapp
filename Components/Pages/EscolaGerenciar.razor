@page "/escola/gerenciar/{EscolaId:int}"
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject AuthStateService Auth
@rendermode InteractiveServer

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- CABEÇALHO RESPONSIVO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-success-subtle text-success fw-bold mb-1 px-3 py-1 rounded-pill">Painel Administrativo</span>
            <h2 class="fw-bold text-dark m-0 fs-3 fs-md-2">🏫 @escola.Nome</h2>
            <p class="text-muted small m-0">Gestão financeira e turmas da unidade.</p>
        </div>
        <div class="d-flex gap-2">
            @if (Auth.TipoUsuario == "SuperAdmin")
            {
                <button class="btn btn-outline-secondary rounded-pill px-3 fw-semibold shadow-sm btn-sm" @onclick="VoltarSuperAdmin">
                    ← Super Admin
                </button>
            }
            <button class="btn btn-primary rounded-pill px-3 fw-semibold shadow-sm btn-sm" @onclick="AbrirModalNovaTurma">
                + Nova Turma
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-4 p-3 shadow-sm mb-4">✅ @mensagemSucesso</div>
    }

    <!-- BLOCO DE SENHA DO PORTAL -->
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white mb-4 border-start border-primary border-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h6 class="fw-bold text-dark mb-1">🔑 Senha do Portal da Unidade</h6>
                <p class="text-muted small m-0">Login: <code class="fw-bold text-dark">@escola.LoginPortal</code></p>
            </div>
            <div>
                @if (!editandoSenhaPortal)
                {
                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold w-100 w-md-auto" @onclick="() => editandoSenhaPortal = true">
                        🔒 Alterar Senha
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 w-100 w-md-auto" @onclick="() => editandoSenhaPortal = false">
                        Cancelar
                    </button>
                }
            </div>
        </div>

        @if (editandoSenhaPortal)
        {
            <div class="row g-2 mt-3 pt-3 border-top align-items-center">
                <div class="col-12 col-md-6">
                    <input type="text" class="form-control rounded-pill" @bind="novaSenhaPortal" placeholder="Nova senha..." />
                </div>
                <div class="col-12 col-md-3">
                    <button class="btn btn-success rounded-pill px-4 fw-semibold w-100 btn-sm" @onclick="SalvarNovaSenhaPortal">
                        Salvar
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- MÉTRICAS FINANCEIRAS (CARDS VERTICAIS NO MOBILE) -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-success border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Receita Efetiva</small>
                <span class="fs-5 fs-md-4 fw-bold text-success">R$ @receitaEfetiva.ToString("N2")</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-primary border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Previsão Mês</small>
                <span class="fs-5 fs-md-4 fw-bold text-primary">R$ @pendenteMesAtual.ToString("N2")</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-warning border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Inadimplentes</small>
                <span class="fs-5 fs-md-4 fw-bold text-warning">@inadimplentesAnterior alunos</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-info border-4">
                <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Total Alunos</small>
                <span class="fs-5 fs-md-4 fw-bold text-info">@totalAlunos ativos</span>
            </div>
        </div>
    </div>

    <!-- LISTAGEM DE TURMAS (ESTILO CARDS TIPO TRELLO/APP NO MOBILE) -->
    <h4 class="fw-bold text-dark mb-3 fs-5">📁 Turmas da Unidade</h4>
    @if (turmasList.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            <p class="text-muted mb-3 small">Nenhuma turma cadastrada nesta unidade.</p>
            <button class="btn btn-primary rounded-pill px-4 mx-auto btn-sm" @onclick="AbrirModalNovaTurma">+ Criar Primeira Turma</button>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var turma in turmasList)
            {
                var alunosTurma = turma.Alunos ?? new();
                decimal recTurma = alunosTurma.Where(a => a.MensalidadeMesPaga).Sum(a => a.ValorMensalidade);
                decimal prevTurma = alunosTurma.Sum(a => a.ValorMensalidade);
                int inadTurma = alunosTurma.Count(a => !a.MensalidadeMesPaga);

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-white h-100 d-flex flex-column justify-content-between position-relative" style="cursor: pointer;" @onclick="() => AcessarTurma(turma.Id)">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-0.5 rounded-pill mb-1" style="font-size: 0.7rem;">Turno: @turma.Turno</span>
                                    <h5 class="fw-bold text-dark m-0">@turma.Nome</h5>
                                    <small class="text-muted">👩‍🏫 @(string.IsNullOrEmpty(turma.ProfessorResponsavel) ? "Sem professora" : turma.ProfessorResponsavel)</small>
                                </div>
                                <span class="badge bg-light text-dark border px-2 py-1">@alunosTurma.Count alunos</span>
                            </div>

                            <div class="bg-light p-2.5 rounded-3 mb-3 small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Recebido:</span>
                                    <span class="fw-bold text-success">R$ @recTurma.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Previsto:</span>
                                    <span class="fw-bold text-primary">R$ @prevTurma.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Pendentes:</span>
                                    <span class="fw-bold text-danger">@inadTurma alunos</span>
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold mt-auto">
                            Gerenciar Turma →
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL CRIAR TURMA -->
@if (exibirModalNovaTurma)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered mx-3 mx-md-auto">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold fs-6">📁 Nova Turma</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalNovaTurma = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nome da Turma</label>
                        <input type="text" class="form-control rounded-pill px-3" @bind="novaTurmaNome" placeholder="Ex: Maternal II" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Turno</label>
                            <select class="form-select rounded-pill px-3" @bind="novoTurmaTurno">
                                <option value="Matutino">Matutino</option>
                                <option value="Vespertino">Vespertino</option>
                                <option value="Integral">Integral</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Professora</label>
                            <input type="text" class="form-control rounded-pill px-3" @bind="novaTurmaProfessor" placeholder="Nome..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3 btn-sm" @onclick="() => exibirModalNovaTurma = false">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold" @onclick="SalvarNovaTurma">Criar Turma</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int EscolaId { get; set; }
    private Escola escola = new();
    private List<Turma> turmasList = new();
    
    private decimal receitaEfetiva = 0;
    private decimal pendenteMesAtual = 0;
    private int inadimplentesAnterior = 0;
    private int totalAlunos = 0;
    private string mensagemSucesso = string.Empty;

    private bool editandoSenhaPortal = false;
    private string novaSenhaPortal = string.Empty;

    private bool exibirModalNovaTurma = false;
    private string novaTurmaNome = string.Empty;
    private string novoTurmaTurno = "Integral";
    private string novaTurmaProfessor = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosEscola();
    }

    private async Task CarregarDadosEscola()
    {
        var e = await Db.Escolas.FindAsync(EscolaId);
        if (e != null) 
        {
            escola = e;
            novaSenhaPortal = escola.SenhaPortal;
        }

        turmasList = await Db.Turmas
            .Where(t => t.EscolaId == EscolaId)
            .Include(t => t.Alunos)
            .ToListAsync();

        receitaEfetiva = 0;
        pendenteMesAtual = 0;
        inadimplentesAnterior = 0;
        totalAlunos = 0;

        foreach (var t in turmasList)
        {
            if (t.Alunos != null)
            {
                foreach (var a in t.Alunos)
                {
                    totalAlunos++;
                    if (a.MensalidadeMesPaga)
                    {
                        receitaEfetiva += a.ValorMensalidade;
                    }
                    else
                    {
                        pendenteMesAtual += a.ValorMensalidade;
                        inadimplentesAnterior++;
                    }
                }
            }
        }
    }

    private async Task SalvarNovaSenhaPortal()
    {
        if (!string.IsNullOrWhiteSpace(novaSenhaPortal))
        {
            escola.SenhaPortal = novaSenhaPortal;
            Db.Escolas.Update(escola);
            await Db.SaveChangesAsync();
            editandoSenhaPortal = false;
            mensagemSucesso = "Senha do portal alterada com sucesso!";
        }
    }

    private void AbrirModalNovaTurma() => exibirModalNovaTurma = true;

    private async Task SalvarNovaTurma()
    {
        if (!string.IsNullOrWhiteSpace(novaTurmaNome))
        {
            var turma = new Turma 
            { 
                Nome = novaTurmaNome, 
                Turno = novoTurmaTurno, 
                ProfessorResponsavel = novaTurmaProfessor, 
                EscolaId = EscolaId 
            };
            Db.Turmas.Add(turma);
            await Db.SaveChangesAsync();
            exibirModalNovaTurma = false;
            novaTurmaNome = string.Empty;
            novoTurmaTurno = "Integral";
            novaTurmaProfessor = string.Empty;
            mensagemSucesso = "Turma criada com sucesso!";
            await CarregarDadosEscola();
        }
    }

    private void AcessarTurma(int turmaId)
    {
        Navigation.NavigateTo($"/escola/turma/{turmaId}");
    }

    private void VoltarSuperAdmin() => Navigation.NavigateTo("/superadmin/escolas");
}