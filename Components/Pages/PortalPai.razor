@page "/portal/pai"
@using ZeloApp.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Zelo - Portal da Família</PageTitle>

@if (responsavelLogado == null)
{
    <!-- TELA DE LOGIN (LIMPA, TELA CHEIA, SEM MENUS) -->
    <div class="container d-flex justify-content-center align-items-center min-vh-100" style="margin-left: -20px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="width: 100%; max-width: 420px;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">📱 Portal da Família</h3>
                <p class="small text-muted">Acesse com seu CPF e a data de nascimento do aluno.</p>
            </div>

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger rounded-3 p-3 small mb-3">⚠️ @mensagemErro</div>
            }

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">CPF do Responsável</label>
                <input type="text" class="form-control rounded-3" @bind="cpfBusca" placeholder="000.000.000-00" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Senha (DDMMAAAA do Aluno)</label>
                <input type="text" class="form-control rounded-3" @bind="senhaBusca" placeholder="Ex: 15032024" />
            </div>

            <button class="btn btn-primary w-100 rounded-3 py-2 fw-semibold shadow-sm" @onclick="Autenticar">
                Entrar no Portal →
            </button>
        </div>
    </div>
}
else
{
    <!-- PAINEL DO PAI COM MENU LATERAL EXCLUSIVO (SUBSTITUI A VISÃO DE ADMIN) -->
    <div class="position-fixed top-0 start-0 w-100 h-100 bg-light d-flex" style="z-index: 2000;">
        
        <!-- MENU LATERAL EXCLUSIVO DO PAI -->
        <div class="d-flex flex-column flex-shrink-0 p-3 bg-white border-end shadow-sm" style="width: 280px;">
            <div class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none px-2">
                <span class="fs-4 fw-bold text-primary">🛡️ Zelo Família</span>
            </div>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a href="#" class="nav-link active rounded-3 fw-semibold">
                        🏠 Início / Aluno
                    </a>
                </li>
            </ul>
            <hr>
            <button class="btn btn-outline-danger btn-sm rounded-3 w-100 fw-semibold py-2" @onclick="Sair">
                🚪 Sair do Portal
            </button>
        </div>

        <!-- CONTEÚDO PRINCIPAL DO PAINEL DO PAI -->
        <div class="flex-grow-1 p-4 overflow-y-auto">
            <div class="container-fluid" style="max-width: 900px;">
                @if (!string.IsNullOrEmpty(mensagemSucesso))
                {
                    <div class="alert alert-success rounded-3 p-3 small mb-4 shadow-sm">✅ @mensagemSucesso</div>
                }

                <div class="row g-4">
                    <!-- Coluna Esquerda: Aluno & Avisos -->
                    <div class="col-12 col-md-5">
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 border-start border-primary border-4">
                            <h5 class="fw-bold text-dark mb-3">👶 Aluno Vinculado</h5>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@criancaVinculada?.FotoUrl" class="rounded-circle shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div>
                                    <h6 class="fw-bold text-dark m-0">@criancaVinculada?.Nome</h6>
                                    <small class="text-muted">Nasc: @criancaVinculada?.DataNascimento.ToShortDateString()</small>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-warning border-4">
                            <h6 class="fw-bold text-dark mb-2">📢 Mural de Avisos</h6>
                            <p class="small text-muted m-0">
                                "Reunião de pais na próxima sexta-feira às 19h. Sua presença é fundamental!"
                            </p>
                        </div>
                    </div>

                    <!-- Coluna Direita: Perfil e Autorizados -->
                    <div class="col-12 col-md-7">
                        <!-- PERFIL DO TITULAR (NOME TRAVADO) -->
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 border-start border-success border-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold text-dark m-0">👤 Meu Perfil (Titular)</h5>
                                <button class="btn btn-sm btn-outline-primary rounded-3 px-3" @onclick="() => editandoPerfil = !editandoPerfil">
                                    @(editandoPerfil ? "Fechar" : "Editar Contato")
                                </button>
                            </div>
                            <p class="small text-muted mb-1"><strong>@responsavelLogado.Nome</strong> (CPF: @responsavelLogado.Cpf)</p>
                            <small class="text-muted d-block">Tel: @responsavelLogado.Telefone</small>

                            @if (editandoPerfil)
                            {
                                <div class="bg-light p-3 rounded-3 border mt-3">
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold text-muted">Nome (Protegido por contrato)</label>
                                        <input type="text" class="form-control form-control-sm rounded-3 bg-white" @bind="responsavelLogado.Nome" disabled />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold">Telefone / WhatsApp</label>
                                        <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelLogado.Telefone" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small fw-bold">Foto de Perfil (URL)</label>
                                        <input type="text" class="form-control form-control-sm rounded-3" @bind="responsavelLogado.FotoUrl" />
                                    </div>
                                    <button class="btn btn-sm btn-success rounded-3 px-3 fw-semibold w-100 mt-2" @onclick="SalvarPerfil">Salvar Alterações</button>
                                </div>
                            }
                        </div>

                        <!-- AUTORIZADOS A RETIRAR -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark m-0">🛡️ Quem Retira a Criança</h5>
                            <button class="btn btn-primary btn-sm rounded-3 px-3 fw-semibold" @onclick="() => exibirModalNovo = true">+ Autorizar Novo</button>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var auth in listaAutorizados)
                            {
                                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrEmpty(auth.FotoUrl) ? "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80" : auth.FotoUrl)" class="rounded-circle shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" />
                                            <div>
                                                <h6 class="fw-bold text-dark m-0">@auth.Nome</h6>
                                                <small class="text-muted d-block">@auth.Parentesco | Tel: @auth.Telefone</small>
                                                <span class="badge @(auth.PodeRetirar ? "bg-success" : "bg-danger") rounded-pill mt-1" style="font-size: 0.65rem;">
                                                    @(auth.PodeRetirar ? "Liberado" : "Bloqueado")
                                                </span>
                                            </div>
                                        </div>
                                        @if (!auth.Principal)
                                        {
                                            <button class="btn btn-outline-danger btn-sm rounded-3 px-2 py-1" @onclick="() => RemoverAutorizado(auth.Id)">Remover</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL NOVO AUTORIZADO -->
    @if (exibirModalNovo)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); z-index: 3000;" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header bg-primary text-white rounded-top-4">
                        <h5 class="modal-title fw-bold">➕ Autorizar Nova Pessoa</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => exibirModalNovo = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nome Completo</label>
                            <input type="text" class="form-control rounded-3" @bind="novoAutorizado.Nome" placeholder="Ex: Tio Roberto" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">CPF</label>
                            <input type="text" class="form-control rounded-3" @bind="novoAutorizado.Cpf" placeholder="000.000.000-00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Telefone / WhatsApp</label>
                            <input type="text" class="form-control rounded-3" @bind="novoAutorizado.Telefone" placeholder="(41) 99999-9999" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Grau de Parentesco</label>
                            <select class="form-select rounded-3" @bind="novoAutorizado.Parentesco">
                                <option value="">Selecione...</option>
                                <option value="Avô / Avó">Avô / Avó</option>
                                <option value="Tio / Tia">Tio / Tia</option>
                                <option value="Irmão(ã) Maior de 18">Irmão(ã) Maior de 18</option>
                                <option value="Primo(a) Maior de 18">Primo(a) Maior de 18</option>
                                <option value="Padrinho / Madrinha">Padrinho / Madrinha</option>
                                <option value="Babá / Cuidador(a)">Babá / Cuidador(a)</option>
                                <option value="Outro Familiar">Outro Familiar</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Tipo de Acesso</label>
                            <select class="form-select rounded-3" @bind="tipoAcesso">
                                <option value="Permanente">Permanente</option>
                                <option value="Provisorio">Provisório (Com período determinado)</option>
                            </select>
                        </div>
                        @if (tipoAcesso == "Provisorio")
                        {
                            <div class="row g-2 mb-3 bg-light p-3 rounded-3 border">
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Início</label>
                                    <input type="date" class="form-control form-control-sm rounded-3" @bind="dataInicio" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Fim</label>
                                    <input type="date" class="form-control form-control-sm rounded-3" @bind="dataFim" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-0 p-3 pt-0">
                        <button type="button" class="btn btn-light rounded-3 px-3 btn-sm" @onclick="() => exibirModalNovo = false">Cancelar</button>
                        <button type="button" class="btn btn-primary rounded-3 px-4 btn-sm fw-semibold" @onclick="SalvarNovoAutorizado">Salvar Autorização</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<!-- PAINEL DE TESTE RÁPIDO FLUTUANTE -->
@if (responsavelLogado == null && testeResponsavel != null)
{
    <div class="position-fixed top-0 end-0 p-3 d-none d-lg-block" style="z-index: 3500; width: 300px;">
        <div class="card border-0 shadow-lg rounded-4 p-3 bg-white border-start border-warning border-4">
            <h6 class="fw-bold text-dark mb-1" style="font-size: 0.85rem;">⚡ Teste Rápido (1 Clique)</h6>
            <button class="btn btn-sm btn-success rounded-3 w-100 fw-semibold mt-2" @onclick="EntrarDiretoPorId">
                Entrar no Portal como Pai 🚀
            </button>
        </div>
    </div>
}

@code {
    private string cpfBusca = string.Empty;
    private string senhaBusca = string.Empty;
    private string mensagemErro = string.Empty;
    private string mensagemSucesso = string.Empty;

    private Responsavel? responsavelLogado;
    private Crianca? criancaVinculada;
    private Responsavel? testeResponsavel;
    private List<Responsavel> listaAutorizados = new();

    private bool editandoPerfil = false;
    private bool exibirModalNovo = false;
    private Responsavel novoAutorizado = new();
    private string tipoAcesso = "Permanente";
    private DateTime dataInicio = DateTime.Today;
    private DateTime dataFim = DateTime.Today.AddDays(7);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            testeResponsavel = await Db.Responsaveis.FirstOrDefaultAsync(r => r.Principal);
        }
        catch (Exception) { }
    }

    private async Task EntrarDiretoPorId()
    {
        if (testeResponsavel != null)
        {
            responsavelLogado = testeResponsavel;
            criancaVinculada = await Db.Criancas.FirstOrDefaultAsync(c => c.Id == testeResponsavel.CriancaId);
            await CarregarAutorizados();
        }
    }

    private async Task Autenticar()
    {
        try
        {
            mensagemErro = string.Empty;
            if (string.IsNullOrWhiteSpace(cpfBusca))
            {
                mensagemErro = "Informe o CPF.";
                return;
            }

            var resp = await Db.Responsaveis
                .Include(r => r.Crianca)
                .FirstOrDefaultAsync(r => r.Cpf.Replace(".", "").Replace("-", "") == cpfBusca.Replace(".", "").Replace("-", "").Trim() && r.Principal);

            if (resp == null || resp.Crianca == null)
            {
                mensagemErro = "Responsável principal não encontrado.";
                return;
            }

            responsavelLogado = resp;
            criancaVinculada = resp.Crianca;
            await CarregarAutorizados();
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro: {ex.Message}";
        }
    }

    private async Task CarregarAutorizados()
    {
        if (criancaVinculada != null)
        {
            listaAutorizados = await Db.Responsaveis.Where(r => r.CriancaId == criancaVinculada.Id).ToListAsync();
        }
    }

    private void Sair()
    {
        responsavelLogado = null;
        criancaVinculada = null;
        listaAutorizados.Clear();
        cpfBusca = string.Empty;
        senhaBusca = string.Empty;
    }

    private async Task SalvarPerfil()
    {
        try
        {
            if (responsavelLogado != null)
            {
                Db.Responsaveis.Update(responsavelLogado);
                await Db.SaveChangesAsync();
                editandoPerfil = false;
                mensagemSucesso = "Seu perfil foi atualizado com sucesso!";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao salvar perfil: {ex.Message}";
        }
    }

    private async Task SalvarNovoAutorizado()
    {
        try
        {
            if (criancaVinculada != null)
            {
                novoAutorizado.CriancaId = criancaVinculada.Id;
                novoAutorizado.Principal = false;
                novoAutorizado.PodeRetirar = true;

                if (tipoAcesso == "Provisorio")
                {
                    novoAutorizado.Parentesco += $" (Prov.: {dataInicio:dd/MM} a {dataFim:dd/MM})";
                }

                if (string.IsNullOrEmpty(novoAutorizado.FotoUrl))
                {
                    novoAutorizado.FotoUrl = "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150&auto=format&fit=crop&q=80";
                }

                Db.Responsaveis.Add(novoAutorizado);
                await Db.SaveChangesAsync();

                exibirModalNovo = false;
                novoAutorizado = new Responsavel();
                mensagemSucesso = "Novo autorizado adicionado!";
                await CarregarAutorizados();
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro: {ex.Message}";
        }
    }

    private async Task RemoverAutorizado(int id)
    {
        var item = await Db.Responsaveis.FindAsync(id);
        if (item != null && !item.Principal)
        {
            Db.Responsaveis.Remove(item);
            await Db.SaveChangesAsync();
            mensagemSucesso = "Removido com sucesso.";
            await CarregarAutorizados();
        }
    }
}