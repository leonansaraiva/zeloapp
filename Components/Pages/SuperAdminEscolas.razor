            padding: 14px;
        }

        .school-mobile-name {
            font-size: 0.85rem;
        }

        .btn-manage-mobile {
            font-size: 0.8rem;
            padding: 10px;
        }
    }

    /* SCROLLBAR PERSONALIZADA */
    .chart-container::-webkit-scrollbar {
        height: 4px;
    }

    .chart-container::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 2px;
    }

    .chart-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 2px;
    }

    .table-responsive-desktop::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive-desktop::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .table-responsive-desktop::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
</style>

@code {
    private List<Escola> listaEscolas = new();
    private Dictionary<int, int> escolasAlunosCount = new();
    private List<MesFinanceiro> demonstrativoAnual = new();
    private decimal receitaEfetivaMes = 0;
    private decimal receitaPrevisaoMes = 0;
    private decimal custoServidor = 150.00m;
    private int escolasInadimplentes = 0;
    private decimal maxValorGrafico = 1000m;
    private string mensagemSucesso = string.Empty;

    public class MesFinanceiro
    {
        public string NomeMes { get; set; } = string.Empty;
        public decimal Receita { get; set; }
    }

    protected override async Task OnInitializedAsync() => await CarregarDadosSuperAdmin();

    private async Task CarregarDadosSuperAdmin()
    {
        listaEscolas = await Db.Escolas.ToListAsync();
        var todasAsTurmas = await Db.Turmas.Include(t => t.Alunos).ToListAsync();
        receitaPrevisaoMes = 0; receitaEfetivaMes = 0; escolasInadimplentes = 0; escolasAlunosCount.Clear();

        foreach (var escola in listaEscolas)
        {
            receitaPrevisaoMes += escola.ValorMensalidadePlataforma;
            if (escola.MensalidadeAtualPaga) receitaEfetivaMes += escola.ValorMensalidadePlataforma;
            else escolasInadimplentes++;
            escolasAlunosCount[escola.Id] = todasAsTurmas.Where(t => t.EscolaId == escola.Id).Sum(t => t.Alunos?.Count ?? 0);
        }

        string[] meses = { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
        demonstrativoAnual.Clear(); maxValorGrafico = 1000m;
        int baseUnidades = Math.Max(1, listaEscolas.Count);

        for (int i = 0; i < meses.Length; i++)
        {
            decimal recMes = i <= DateTime.Now.Month - 1 ? (baseUnidades * 450.00m) : 0;
            if (recMes > maxValorGrafico) maxValorGrafico = recMes;
            demonstrativoAnual.Add(new MesFinanceiro { NomeMes = meses[i], Receita = recMes });
        }
    }

    private void GerenciarEscola(int id) => Navigation.NavigateTo($"/superadmin/escola/gerenciar/{id}");
}