@page "/superadmin/escolas"
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject AuthStateService Auth
@rendermode InteractiveServer

<PageTitle>Zelo - Painel Super Admin (SaaS)</PageTitle>

<div class="saas-dashboard">
    <!-- HEADER -->
    <div class="dashboard-header">
        <div class="header-content">
            <div class="header-left">
                <span class="header-badge">Painel Administrativo Geral</span>
                <h1 class="header-title">Gestão de Escolas & SaaS</h1>
                <p class="header-subtitle">Acompanhamento financeiro anual e aquisição de clientes.</p>
            </div>
            <div class="header-right">
                <a href="/superadmin/escola/nova" class="btn-primary-custom">
                    <span class="btn-icon">➕</span>
                    Nova Escola (Cliente)
                </a>
            </div>
        </div>
    </div>

    <!-- MÉTRICAS -->
    <div class="metrics-grid">
        <div class="metric-card metric-receita">
            <div class="metric-content">
                <span class="metric-label">Receita Efetiva (Pago)</span>
                <span class="metric-value text-success">R$ @receitaEfetivaMes.ToString("N2")</span>
            </div>
        </div>

        <div class="metric-card metric-previsao">
            <div class="metric-content">
                <span class="metric-label">Previsão de Receita</span>
                <span class="metric-value text-primary">R$ @receitaPrevisaoMes.ToString("N2")</span>
            </div>
        </div>

        <div class="metric-card metric-custo">
            <div class="metric-content">
                <span class="metric-label">Custo Fixo (Servidor)</span>
                <span class="metric-value text-danger">R$ @custoServidor.ToString("N2")</span>
            </div>
        </div>

        <div class="metric-card metric-inadimplentes">
            <div class="metric-content">
                <span class="metric-label">Inadimplentes (Mês)</span>
                <span class="metric-value text-warning">@escolasInadimplentes</span>
            </div>
        </div>
    </div>

    <!-- GRÁFICO -->
    <div class="chart-card">
        <div class="chart-header">
            <div>
                <h5 class="chart-title">📊 Demonstrativo Financeiro Anual</h5>
                <p class="chart-subtitle">Evolução do faturamento mês a mês</p>
            </div>
        </div>

        <div class="chart-container">
            <div class="chart-bars">
                @foreach (var m in demonstrativoAnual)
                {
                    var alturaPct = maxValorGrafico > 0 ? (int)((m.Receita / maxValorGrafico) * 130) : 10;
                    <div class="chart-bar-wrapper">
                        <span class="chart-bar-value">R$ @m.Receita.ToString("N0")</span>
                        <div class="chart-bar-track">
                            <div class="chart-bar-fill" style="height: @Math.Max(alturaPct, 5)px;"></div>
                        </div>
                        <span class="chart-bar-label">@m.NomeMes.Substring(0, 3)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- MENSAGEM DE SUCESSO -->
    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert-success-custom">
            <span class="alert-icon">✅</span>
            @mensagemSucesso
        </div>
    }

    <!-- TABELA / CARDS DE ESCOLAS -->
    <div class="schools-card">
        <div class="schools-header">
            <div class="schools-header-left">
                <span class="schools-icon">🏫</span>
                <h5 class="schools-title">Escolas Clientes da Plataforma</h5>
            </div>
            <span class="schools-count">@listaEscolas.Count unidades</span>
        </div>

        <!-- VISÃO DE TABELA PARA DESKTOP -->
        <div class="table-responsive-desktop">
            <table class="schools-table">
                <thead>
                    <tr>
                        <th>Escola / CNPJ</th>
                        <th>Gestor(a) & Contato</th>
                        <th>Alunos</th>
                        <th>Assinatura</th>
                        <th>Status</th>
                        <th class="text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var escola in listaEscolas)
                    {
                        <tr>
                            <td>
                                <div class="school-name">@escola.Nome</div>
                                <div class="school-cnpj">@escola.Cnpj</div>
                            </td>
                            <td>
                                <div class="school-gestor">@escola.NomeGestor</div>
                                <div class="school-contato">@escola.TelefoneGestor</div>
                            </td>
                            <td>
                                <span class="school-alunos-badge">@(escolasAlunosCount.ContainsKey(escola.Id) ? escolasAlunosCount[escola.Id] : 0)</span>
                            </td>
                            <td>
                                <span class="school-valor">R$ @escola.ValorMensalidadePlataforma.ToString("N2")</span>
                            </td>
                            <td>
                                @if (escola.MensalidadeAtualPaga)
                                {
                                    <span class="status-badge status-paid">🟢 Pago</span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">🔴 Pendente</span>
                                }
                            </td>
                            <td class="text-right">
                                <button class="btn-manage" @onclick="() => GerenciarEscola(escola.Id)">
                                    Gerenciar →
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- VISÃO EM CARDS PARA MOBILE -->
        <div class="schools-mobile-cards">
            @foreach (var escola in listaEscolas)
            {
                <div class="school-mobile-card">
                    <div class="school-mobile-header">
                        <div>
                            <h6 class="school-mobile-name">@escola.Nome</h6>
                            <span class="school-mobile-cnpj">CNPJ: @escola.Cnpj</span>
                        </div>
                        <div>
                            @if (escola.MensalidadeAtualPaga)
                            {
                                <span class="status-badge status-paid">🟢 Pago</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending">🔴 Pendente</span>
                            }
                        </div>
                    </div>
                    <div class="school-mobile-body">
                        <div class="school-mobile-info">
                            <span class="info-label">Gestor(a):</span>
                            <span class="info-value">@escola.NomeGestor</span>
                        </div>
                        <div class="school-mobile-info">
                            <span class="info-label">Alunos:</span>
                            <span class="info-value">@(escolasAlunosCount.ContainsKey(escola.Id) ? escolasAlunosCount[escola.Id] : 0)</span>
                        </div>
                        <div class="school-mobile-info">
                            <span class="info-label">Valor:</span>
                            <span class="info-value text-success">R$ @escola.ValorMensalidadePlataforma.ToString("N2")</span>
                        </div>
                    </div>
                    <button class="btn-manage-mobile" @onclick="() => GerenciarEscola(escola.Id)">
                        Gerenciar Unidade →
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
