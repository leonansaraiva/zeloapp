@page "/escola/aluno/{AlunoId:int}/responsaveis"
@rendermode InteractiveServer
@using ZeloApp.Models
@using ZeloApp.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<PageTitle>Gerenciar Responsáveis e Autorizados</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark m-0">👥 Responsáveis e Autorizados</h3>
            <p class="text-muted small m-0">Aluno: <strong>@aluno.NomeCompleto</strong> | Vínculo: @aluno.Vinculo</p>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="Voltar">⬅ Voltar ao Aluno / Turma</button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemSucesso))
    {
        <div class="alert alert-success rounded-4 p-3 shadow-sm mb-3">✅ @mensagemSucesso</div>
    }

    <!-- 1. VÍNCULO E RESPONSÁVEL FINANCEIRO -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <h5 class="fw-bold text-primary mb-3">1. Vínculo e Responsável Financeiro</h5>
        <EditForm Model="aluno" OnValidSubmit="SalvarVinculoFinanceiro">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Tipo de Vínculo</label>
                    <InputSelect class="form-select rounded-pill" @bind-Value="aluno.Vinculo">
                        <option value="Particular">Particular</option>
                        <option value="Prefeitura">Prefeitura (Conveniado)</option>
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    @if (aluno.Vinculo == "Prefeitura")
                    {
                        <div class="p-2 bg-light rounded-pill border small px-3 text-muted">
                            🏛️ Financeiro sob responsabilidade da Prefeitura Municipal.
                        </div>
                    }
                    else
                    {
                        <label class="form-label small fw-bold">Nome do Responsável Legal / Financeiro</label>
                        <InputText class="form-control rounded-pill" @bind-Value="aluno.NomeResponsavel" placeholder="Nome do pai, mãe ou responsável..." />
                    }
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold shadow-sm">Salvar</button>
                </div>
            </div>
        </EditForm>
    </div>

    <!-- 2. PESSOAS AUTORIZADAS / RESPONSÁVEIS DE RETIRADA -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="fw-bold text-primary m-0">2. Pessoas Autorizadas a Retirar o Aluno</h5>
                <small class="text-muted">Cadastre pais, avós, tios ou autorizados temporários com controle de vigência.</small>
            </div>
        </div>

        <!-- Formulário para Adicionar Novo Autorizado -->
        <div class="p-3 bg-light rounded-4 border mb-4">
            <h6 class="fw-bold text-dark mb-3">➕ Adicionar Nova Pessoa Autorizada</h6>
            <EditForm Model="novoResponsavel" OnValidSubmit="AdicionarResponsavel">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Nome Completo *</label>
                        <InputText class="form-control rounded-pill" @bind-Value="novoResponsavel.NomeCompleto" placeholder="Nome da pessoa..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Parentesco / Relação *</label>
                        <InputText class="form-control rounded-pill" @bind-Value="novoResponsavel.Parentesco" placeholder="Ex: Avô, Tio, Mãe..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Telefone / WhatsApp</label>
                        <InputText class="form-control rounded-pill" @bind-Value="novoResponsavel.Telefone" placeholder="(41) 99999-9999" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">CPF</label>
                        <InputText class="form-control rounded-pill" @bind-Value="novoResponsavel.Cpf" placeholder="000.000.000-00" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" @bind-Value="novoResponsavel.Temporario" id="chkTemp" />
                            <label class="form-check-label small fw-semibold" for="chkTemp">Autorização Temporária?</label>
                        </div>
                    </div>
                    @if (novoResponsavel.Temporario)
                    {
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Data Início</label>
                            <InputDate class="form-control rounded-pill" @bind-Value="novoResponsavel.DataInicio" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Data Fim</label>
                            <InputDate class="form-control rounded-pill" @bind-Value="novoResponsavel.DataFim" />
                        </div>
                    }
                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">Cadastrar Autorizado</button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Lista de Autorizados Cadastrados -->
        <h6 class="fw-bold text-dark mb-3">Lista de Autorizados Atuais</h6>
        @if (listaResponsaveis == null || !listaResponsaveis.Any())
        {
            <p class="text-muted small fst-italic">Nenhum responsável ou autorizado extra cadastrado para este aluno ainda.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Nome / Parentesco</th>
                            <th>Contato</th>
                            <th>Tipo de Autorização</th>
                            <th class="text-end pe-3">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resp in listaResponsaveis)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@resp.NomeCompleto</div>
                                    <small class="text-muted">@resp.Parentesco</small>
                                </td>
                                <td>
                                    <div>@resp.Telefone</div>
                                    <small class="text-muted">CPF: @resp.Cpf</small>
                                </td>
                                <td>
                                    @if (resp.Temporario)
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2 py-1 rounded-pill">⏱️ Temporário (@(resp.DataInicio?.ToString("dd/MM")) até @(resp.DataFim?.ToString("dd/MM")))</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">✅ Permanente</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" style="font-size: 0.7rem;" @onclick="() => RemoverResponsavel(resp.Id)">Excluir</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int AlunoId { get; set; }
    private Aluno aluno = new();
    private List<Responsavel> listaResponsaveis = new();
    private Responsavel novoResponsavel = new() { Temporario = false, DataInicio = DateTime.Today, DataFim = DateTime.Today.AddDays(7) };
    private string mensagemSucesso = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        var alunoDb = await Db.Alunos.Include(a => a.Turma).FirstOrDefaultAsync(a => a.Id == AlunoId);
        if (alunoDb != null)
        {
            aluno = alunoDb;
        }
        listaResponsaveis = await Db.Responsaveis.Where(r => r.AlunoId == AlunoId).ToListAsync();
    }

    private async Task SalvarVinculoFinanceiro()
    {
        if (aluno != null)
        {
            if (aluno.Vinculo == "Prefeitura")
            {
                aluno.NomeResponsavel = "Prefeitura Municipal";
            }
            Db.Alunos.Update(aluno);
            await Db.SaveChangesAsync();
            mensagemSucesso = "Vínculo financeiro atualizado com sucesso!";
        }
    }

    private async Task AdicionarResponsavel()
    {
        if (string.IsNullOrWhiteSpace(novoResponsavel.NomeCompleto)) return;

        novoResponsavel.AlunoId = AlunoId;
        novoResponsavel.EscolaId = aluno?.Turma?.EscolaId ?? 1;

        Db.Responsaveis.Add(novoResponsavel);
        await Db.SaveChangesAsync();

        novoResponsavel = new() { Temporario = false, DataInicio = DateTime.Today, DataFim = DateTime.Today.AddDays(7) };
        mensagemSucesso = "Pessoa autorizada cadastrada com sucesso!";
        await CarregarDados();
    }

    private async Task RemoverResponsavel(int id)
    {
        var resp = await Db.Responsaveis.FindAsync(id);
        if (resp != null)
        {
            Db.Responsaveis.Remove(resp);
            await Db.SaveChangesAsync();
            mensagemSucesso = "Autorizado removido com sucesso!";
            await CarregarDados();
        }
    }

    private void Voltar() => Navigation.NavigateTo($"/escola/turma/{aluno?.TurmaId}");
}