@inherits LayoutComponentBase

<div class="d-flex flex-column vh-100 overflow-hidden bg-light">
    <!-- Navbar fixa no topo que nunca some -->
    <div class="flex-shrink-0">
        <NavMenu />
    </div>
    
    <!-- Miolo da aplicação com scroll interno controlado -->
    <main class="flex-grow-1 overflow-y-auto w-100">
