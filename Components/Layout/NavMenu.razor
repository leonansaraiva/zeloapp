@rendermode InteractiveServer

<div class="top-row px-3 bg-primary text-white d-flex justify-content-between align-items-center shadow-sm" style="height: 56px;">
    <a class="navbar-brand fw-bold text-white fs-5 m-0" href="">🛡️ ZeloApp</a>
    <button class="btn text-white fs-4 p-0 border-0" @onclick="ToggleNav">
        @(menuAberto ? "✕" : "☰")
    </button>
</div>

@if (menuAberto)
{
    <div class="mobile-nav-overlay" @onclick="FecharNav">
        <div class="text-white-50 small fw-bold mb-2">SUPER ADMIN</div>
        <a href="" class="btn btn-outline-light text-start mb-2 py-2 fw-semibold">
            🏠 Painel Geral
        </a>
        <a href="superadmin/escolas" class="btn btn-outline-light text-start mb-3 py-2 fw-semibold">
            🏫 Gestão de Escolas
        </a>

        <hr class="border-secondary my-2" />

        <div class="text-white-50 small fw-bold mb-2">PORTAL DA FAMÍLIA</div>
        <a href="portal/pai" class="btn btn-primary text-start py-2 fw-semibold">
            📱 Visão do Pai / Mãe
        </a>
    </div>
}

<!-- Botão Flutuante de Instalação do PWA -->
<div id="pwa-install-btn">
    <button class="pwa-float-btn" onclick="instalarPWA()">
        📲 Instalar ZeloApp
    </button>
</div>

@code {
    private bool menuAberto = false;

    private void ToggleNav() => menuAberto = !menuAberto;
    private void FecharNav() => menuAberto = false;
}