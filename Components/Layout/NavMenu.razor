@* App.razor ou MainLayout.razor *@
@inherits LayoutComponentBase

<div class="page @(sidebarAberto ? "has-sidebar" : "")">
    <!-- Sidebar -->
    <div class="sidebar @(sidebarAberto ? "open" : "")">
        <NavMenu />
    </div>

    <!-- Backdrop para mobile -->
    <div class="sidebar-backdrop @(sidebarAberto ? "show" : "")" @onclick="FecharSidebar"></div>

    <!-- Conteúdo Principal -->
    <main>
        <div class="top-row px-4">
            <!-- Botão hambúrguer para mobile -->
            <button class="btn btn-link d-md-none text-white p-0 me-2" @onclick="ToggleSidebar">
                <span style="font-size: 1.5rem;">☰</span>
            </button>
            <a href="/" class="text-white text-decoration-none fw-bold d-md-none">
                🛡️ ZeloApp
            </a>
            <div class="ms-auto">
                @* Aqui vai o conteúdo do top-row (perfil, notificações, etc) *@
                <a href="/perfil" class="text-white text-decoration-none">
                    👤 Perfil
                </a>
                <a href="/configuracoes" class="text-white text-decoration-none">
                    ⚙️
                </a>
            </div>
        </div>

        <div class="content">
            @Body
        </div>
    </main>
</div>

<style>
    /* CSS do layout acima */
</style>

@code {
    private bool sidebarAberto = false;

    private void ToggleSidebar()
    {
        sidebarAberto = !sidebarAberto;
        AtualizarBodyScroll();
    }

    private void FecharSidebar()
    {
        sidebarAberto = false;
        AtualizarBodyScroll();
    }

    private async void AtualizarBodyScroll()
    {
        try
        {
            if (sidebarAberto && !IsDesktop())
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.add", "no-scroll");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.remove", "no-scroll");
            }
        }
        catch { }
    }

    private bool IsDesktop()
    {
        return System.OperatingSystem.IsBrowser() ? false : true;
        // Ou use: return System.OperatingSystem.IsBrowser() ? false : true;
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}