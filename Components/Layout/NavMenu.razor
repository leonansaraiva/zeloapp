<div class="top-row ps-3 navbar navbar-dark bg-primary shadow-sm">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">🛡️ ZeloApp</a>
        <!-- Botão hambúrguer que só aparece no celular -->
        <button title="Navigation menu" class="navbar-toggler border-0 shadow-none d-md-none" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<!-- Menu lateral: visível direto no PC (d-md-block) e controlado por clique no celular -->
<div class="@NavMenuCssClass nav-scrollable bg-white border-end shadow-sm" style="min-height: calc(100vh - 3.5rem);">
    <nav class="flex-column p-3">
        <div class="nav-item px-2 mb-2">
            <NavLink class="nav-link rounded-3 px-3 py-2 text-dark fw-semibold" href="" Match="NavLinkMatch.All">
                🏠 Painel Geral
            </NavLink>
        </div>
        <div class="nav-item px-2 mb-2">
            <NavLink class="nav-link rounded-3 px-3 py-2 text-dark fw-semibold" href="/superadmin/escolas">
                🏫 Gestão de Escolas
            </NavLink>
        </div>
        <div class="nav-item px-2 mb-2">
            <NavLink class="nav-link rounded-3 px-3 py-2 text-dark fw-semibold" href="/portal/pai">
                📱 Portal da Família
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    
    // Garante que no computador (md para cima) o menu fica sempre aberto, e no celular alterna
    private string? NavMenuCssClass => collapseNavMenu ? "collapse d-md-block" : "show";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
