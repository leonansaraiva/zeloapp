@code {
    private bool menuAberto = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }

    private void ToggleMenu()
    {
        menuAberto = !menuAberto;
        _ = AtualizarBodyScroll();
    }

    private void AbrirMenu()
    {
        menuAberto = true;
        _ = AtualizarBodyScroll();
    }

    private void FecharMenu()
    {
        menuAberto = false;
        _ = AtualizarBodyScroll();
    }

    private async Task AtualizarBodyScroll()
    {
        try
        {
            if (menuAberto)
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.add", "nav-open");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("document.body.classList.remove", "nav-open");
            }
        }
        catch
        {
            // Ignora erros de JavaScript
        }
    }

    private void FazerLogout()
    {
        FecharMenu();
        Auth.FazerLogout();
        Navigation.NavigateTo("/login");
    }
}