@rendermode InteractiveServer
@using ZeloApp.Services
@inject AuthStateService Auth
@inject NavigationManager Navigation
@implements IDisposable

<!-- BARRA DE TOPO (Apenas visível no mobile, no desktop é ocultada) -->
<div class="top-row mobile-only">
    <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Abrir menu">
        <span class="hamburger-icon @(menuAberto ? "active" : "")">
            <span></span>
            <span></span>
            <span></span>
        </span>
    </button>
    <a href="/" class="brand-mobile">🛡️ ZeloApp</a>
    <div class="top-row-right">
        @if (Auth.EstaAutenticado)
        {
            <span class="user-badge">
                <span class="user-avatar">👤</span>
                <span class="user-name">@Auth.UsuarioNome</span>
            </span>
        }
        <a class="nav-link" href="/perfil">👤</a>
        <a class="nav-link" href="/configuracoes">⚙️</a>
    </div>
</div>

<!-- BACKDROP ESCURO PARA MOBILE -->
@if (menuAberto)
{
    <div class="sidebar-backdrop" @onclick="FecharMenu"></div>
}

<!-- SIDEBAR / GAVETA LATERAL -->
<aside class="sidebar @(menuAberto ? "open" : "")">
    <div class="sidebar-brand">
        <span class="brand-icon">🛡️</span>
        <span class="brand-text">ZeloApp</span>
        <span class="brand-version">v1.0</span>
        <!-- BOTÃO DE FECHAR (X) EXCLUSIVO PARA MOBILE -->
        <button class="close-sidebar-btn" @onclick="FecharMenu" aria-label="Fechar menu">
            ✕
        </button>
    </div>

    <div class="sidebar-scroll">
        <div class="nav-menu-inner">
            @if (Auth.EstaAutenticado)
            {
                <div class="user-profile-card">
                    <div class="profile-avatar">👤</div>
                    <div class="profile-info">
                        <div class="profile-label">Perfil Conectado</div>
                        <div class="profile-name">@Auth.UsuarioNome</div>
                        <span class="profile-badge">@Auth.TipoUsuario</span>
                    </div>
                </div>

                <div class="menu-links">
                    @if (Auth.TipoUsuario == "SuperAdmin")
                    {
                        <NavLink class="menu-link" href="/superadmin/escolas" Match="NavLinkMatch.All">
                            <span class="menu-icon">🏫</span>
                            <span class="menu-text">Gestão de Escolas</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                        <NavLink class="menu-link" href="/despesas" Match="NavLinkMatch.All">
                            <span class="menu-icon">💸</span>
                            <span class="menu-text">Despesas do SaaS</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                    }
                    else if (Auth.EscolaId > 0)
                    {
                        <NavLink class="menu-link" href="@($"/escola/gerenciar/{Auth.EscolaId}")" Match="NavLinkMatch.All">
                            <span class="menu-icon">📊</span>
                            <span class="menu-text">Painel da Unidade</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                        <NavLink class="menu-link" href="@($"/escola/despesas/{Auth.EscolaId}")" Match="NavLinkMatch.All">
                            <span class="menu-icon">💸</span>
                            <span class="menu-text">Despesas da Unidade</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                        <NavLink class="menu-link" href="/escola/alunos" Match="NavLinkMatch.All">
                            <span class="menu-icon">👶</span>
                            <span class="menu-text">Todos os Alunos</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                        <NavLink class="menu-link" href="/escola/responsaveis" Match="NavLinkMatch.All">
                            <span class="menu-icon">👥</span>
                            <span class="menu-text">Responsáveis</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                        <NavLink class="menu-link" href="/escola/professores" Match="NavLinkMatch.All">
                            <span class="menu-icon">👩‍🏫</span>
                            <span class="menu-text">Professoras</span>
                            <span class="menu-arrow">→</span>
                        </NavLink>
                    }
                </div>

                <div class="drawer-footer">
                    <button class="logout-btn" @onclick="FazerLogout">
                        <span class="logout-icon">🚪</span>
                        <span class="logout-text">Sair da Conta</span>
                        <span class="logout-arrow">→</span>
                    </button>
                </div>
            }
            else
            {
                <div class="auth-placeholder">
                    <div class="auth-icon">🔐</div>
                    <p class="auth-message">Você não está autenticado no momento.</p>
                    <NavLink class="login-btn" href="/login">
                        <span class="login-icon">🔑</span>
                        <span class="login-text">Fazer Login</span>
                    </NavLink>
                </div>
            }
        </div>
    </div>

    <div class="sidebar-footer-brand">
        <span class="footer-copy">© 2026 ZeloApp</span>
    </div>
</aside>

<style>
    /* TOP ROW & HAMBURGER (MOBILE) */
    .top-row { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.1); justify-content: space-between; height: 64px; display: flex; align-items: center; padding: 0 16px; position: sticky; top: 0; z-index: 1030; box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1); flex-shrink: 0; width: 100%; }
    .menu-toggle { background: transparent; border: none; padding: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 8px; transition: all 0.2s ease; color: white; flex-shrink: 0; }
    .menu-toggle:hover { background: rgba(255, 255, 255, 0.1); transform: scale(1.05); }
    
    .hamburger-icon { display: flex; flex-direction: column; gap: 4.5px; width: 22px; transition: all 0.3s ease; }
    .hamburger-icon span { display: block; height: 2.5px; background: white; border-radius: 2px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); transform-origin: center; }
    .hamburger-icon.active span:nth-child(1) { transform: rotate(45deg) translate(4.5px, 4.5px); }
    .hamburger-icon.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger-icon.active span:nth-child(3) { transform: rotate(-45deg) translate(4.5px, -4.5px); }
    
    .brand-mobile { color: white; text-decoration: none; font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; margin-right: auto; margin-left: 8px; }
    .top-row-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .user-badge { display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.15); padding: 4px 12px 4px 8px; border-radius: 50px; border: 1px solid rgba(255, 255, 255, 0.1); margin-right: 4px; }
    .user-avatar { font-size: 1.1rem; }
    .user-name { color: white; font-size: 0.8rem; font-weight: 500; white-space: nowrap; max-width: 120px; overflow: hidden; text-overflow: ellipsis; }
    .nav-link { color: rgba(255, 255, 255, 0.8); text-decoration: none; padding: 6px 8px; border-radius: 8px; font-size: 1.1rem; }

    /* SIDEBAR / GAVETA */
    .sidebar {
        background: linear-gradient(180deg, #0f172a 0%, #1e3a8a 100%);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 4px 0 25px rgba(0, 0, 0, 0.3);
        position: fixed;
        top: 0; left: 0; bottom: 0;
        width: 280px;
        z-index: 1040;
        transform: translateX(-100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: white;
    }
    .sidebar.open { transform: translateX(0) !important; }

    .sidebar-brand { display: flex; align-items: center; gap: 12px; padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); flex-shrink: 0; background: rgba(255, 255, 255, 0.02); }
    .brand-icon { font-size: 1.8rem; }
    .brand-text { font-size: 1.2rem; font-weight: 700; color: white; }
    .brand-version { font-size: 0.6rem; color: rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.05); padding: 2px 10px; border-radius: 50px; font-weight: 600; }
    
    .close-sidebar-btn {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        cursor: pointer;
        margin-left: auto;
        transition: background 0.2s;
    }
    .close-sidebar-btn:hover { background: rgba(255, 255, 255, 0.25); }
    
    .sidebar-scroll { flex: 1; overflow-y: auto; padding: 8px 0; }
    .nav-menu-inner { display: flex; flex-direction: column; gap: 16px; padding: 4px 12px 16px 12px; }

    .user-profile-card { display: flex; align-items: center; gap: 14px; background: rgba(255, 255, 255, 0.06); padding: 16px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.06); color: white; }
    .profile-avatar { font-size: 1.8rem; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border-radius: 50%; }
    .profile-info { flex: 1; }
    .profile-label { font-size: 0.65rem; text-transform: uppercase; opacity: 0.5; font-weight: 600; margin-bottom: 2px; }
    .profile-name { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
    .profile-badge { background: linear-gradient(135deg, #3b82f6, #60a5fa); color: white; font-size: 0.6rem; font-weight: 600; padding: 2px 10px; border-radius: 50px; text-transform: uppercase; }

    .menu-links { display: flex; flex-direction: column; gap: 4px; }
    .menu-link { display: flex; align-items: center; gap: 14px; padding: 12px 16px; color: rgba(255, 255, 255, 0.75); text-decoration: none; border-radius: 12px; transition: all 0.2s ease; font-weight: 500; font-size: 0.9rem; }
    .menu-link:hover { background: rgba(255, 255, 255, 0.08); color: white; }
    .menu-link.active { background: rgba(255, 255, 255, 0.1); color: white; }
    .menu-icon { font-size: 1.1rem; width: 24px; text-align: center; }
    .menu-text { flex: 1; }
    .menu-arrow { opacity: 0; transition: all 0.3s ease; font-size: 0.9rem; }
    .menu-link:hover .menu-arrow { opacity: 1; }

    .drawer-footer { margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
    .logout-btn { display: flex; align-items: center; gap: 14px; width: 100%; padding: 12px 16px; background: rgba(239, 68, 68, 0.12); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.15); border-radius: 12px; font-weight: 600; font-size: 0.9rem; cursor: pointer; }
    .logout-btn:hover { background: rgba(239, 68, 68, 0.2); color: white; }
    .logout-icon { font-size: 1.1rem; }
    .logout-text { flex: 1; text-align: left; }

    .sidebar-footer-brand { padding: 12px 24px 16px; border-top: 1px solid rgba(255, 255, 255, 0.05); text-align: center; font-size: 0.65rem; color: rgba(255, 255, 255, 0.2); }
    .footer-copy { opacity: 0.5; }

    .sidebar-backdrop { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); z-index: 1035; }

    /* AJUSTES PARA DESKTOP */
    @@media (min-width: 769px) {
        .top-row.mobile-only { display: none !important; } /* Some com a barra superior no PC */
        .sidebar { 
            transform: translateX(0) !important; 
            position: fixed; 
            height: 100vh; 
            top: 0; 
            left: 0;
            width: 280px;
        }
        .sidebar-backdrop { display: none; }
        .close-sidebar-btn { display: none; } /* Esconde o botão X no PC */
    }
</style>

@code {
    private bool menuAberto = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (menuAberto)
        {
            menuAberto = false;
            StateHasChanged();
        }
    }

    private void ToggleMenu()
    {
        menuAberto = !menuAberto;
    }

    private void FecharMenu()
    {
        menuAberto = false;
    }

    private void FazerLogout()
    {
        FecharMenu();
        Auth.FazerLogout();
        Navigation.NavigateTo("/login");
    }
}