@rendermode InteractiveServer
@using ZeloApp.Services
@inject AuthStateService Auth
@inject NavigationManager Navigation
@implements IDisposable

<!-- TOP NAVBAR PRINCIPAL -->
<nav class="navbar navbar-dark bg-primary px-3 shadow-sm sticky-top" style="height: 56px; z-index: 1050;">
    <div class="container-fluid p-0">
        <!-- BOTÃO HAMBÚRGUER (ABRE O MENU LATERAL ESQUERDO) -->
        <button class="btn btn-link text-white p-0 text-decoration-none fs-4 border-0 shadow-none me-2" @onclick="ToggleMenu">
            ☰
        </button>

        <!-- LOGO / NOME -->
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2 me-auto" href="">
            <span>🛡️</span> ZeloApp
        </a>
        
        <!-- PERFIL RÁPIDO NO TOPO -->
        @if (Auth.EstaAutenticado)
        {
            <span class="badge bg-white text-primary fw-semibold px-2.5 py-1 rounded-pill shadow-sm" style="font-size: 0.7rem;">
                👤 @Auth.UsuarioNome
            </span>
        }
    </div>
</nav>

<!-- MENU LATERAL DESLIZANTE PELA ESQUERDA (GAVETA / DRAWER) -->
@if (menuAberto)
{
    <!-- Overlay escuro de fundo -->
    <div class="mobile-nav-overlay" @onclick="ToggleMenu">
        
        <!-- Cabeçalho da Gaveta -->
        <div class="d-flex justify-content-between align-items-center mb-4 text-white border-bottom pb-3">
            <h5 class="fw-bold m-0">🧭 Menu do Sistema</h5>
            <button class="btn btn-sm text-white border-0 fs-4 p-0" @onclick="ToggleMenu">✕</button>
        </div>

        <!-- Conteúdo do Menu -->
        <div class="d-flex flex-column gap-3 flex-grow-1">
            @if (Auth.EstaAutenticado)
            {
                <div class="p-3 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-25 text-white mb-2">
                    <small class="d-block opacity-75 fw-semibold mb-1">Perfil Conectado:</small>
                    <div class="fw-bold fs-6">@Auth.UsuarioNome</div>
                    <span class="badge bg-white text-primary mt-1 px-2 py-0.5" style="font-size: 0.65rem;">@Auth.TipoUsuario</span>
                </div>

                @if (Auth.TipoUsuario == "SuperAdmin")
                {
                    <NavLink class="btn btn-light text-start fw-semibold rounded-pill px-4 py-2.5 text-dark shadow-sm" href="/superadmin/escolas" Match="NavLinkMatch.All" @onclick="ToggleMenu">
                        🏫 Gestão de Escolas
                    </NavLink>
                }
                else if (Auth.EscolaId > 0)
                {
                    <NavLink class="btn btn-light text-start fw-semibold rounded-pill px-4 py-2.5 text-dark shadow-sm" href="@($"/escola/gerenciar/{Auth.EscolaId}")" Match="NavLinkMatch.All" @onclick="ToggleMenu">
                        📊 Painel da Unidade
                    </NavLink>
                }

                <div class="mt-auto pt-3 border-top border-white border-opacity-25">
                    <button class="btn btn-danger w-100 rounded-pill py-2.5 fw-semibold shadow-sm" @onclick="FazerLogout">
                        🚪 Sair da Conta
                    </button>
                </div>
            }
            else
            {
                <div class="text-center text-white mt-4">
                    <p class="opacity-75 small mb-3">Você não está autenticado no momento.</p>
                    <NavLink class="btn btn-light text-primary w-100 rounded-pill py-2.5 fw-semibold shadow" href="/login" @onclick="ToggleMenu">
                        🔑 Fazer Login
                    </NavLink>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool menuAberto = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }

    private void ToggleMenu()
    {
        menuAberto = !menuAberto;
    }

    private void FazerLogout()
    {
        Auth.FazerLogout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}